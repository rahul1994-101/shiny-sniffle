@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrEmpty(relative) ? "/" : "/" + relative.TrimStart('/');
        var loginUrl = $"{AuthConstants.LoginPath}?{AuthConstants.ReturnUrlQuery}={Uri.EscapeDataString(returnUrl)}";
        NavigationManager.NavigateTo(loginUrl, forceLoad: true);
    }
}
