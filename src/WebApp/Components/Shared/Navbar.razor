<header class="layout-navbar">
    <div class="layout-navbar-start">
        <button type="button"
                id="sidebar-toggle-btn"
                class="sidebar-toggle-btn"
                data-shell-toggle
                aria-expanded="true"
                aria-controls="app-sidebar"
                title="Hide sidebar">
            <svg class="sidebar-toggle-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M9 4v16" />
            </svg>
        </button>
    </div>
    <div class="layout-navbar-end">
        <button type="button"
                class="layout-navbar-theme"
                data-theme-toggle
                aria-label="Switch to light mode"
                title="Light mode">
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
        </button>
    </div>
</header>
