@page "/help"
@inherits BaseComponent

@attribute [Authorize]

@inject OnboardingProgressService OnboardingProgress

<PageTitle>Help</PageTitle>

<SettingsShell Title="Help"
               Subtitle="Guides and reference for the app.">
    <div class="settings-sections help-page">
        <nav class="ui-group" aria-label="Setup">
            <NavLink class="ui-group-row" href="/help/getting-started">
                <span class="ui-group-row-leading">
                    <NavIcon Name="NavIconName.GettingStarted" CssClass="ui-group-row-icon" />
                    <span>
                        @if (_onboardingSummary is { IsComplete: false })
                        {
                            <span class="ui-list-row-meta">
                                <span class="ui-group-row-title">Getting started</span>
                                <span class="ui-list-row-badge">@_onboardingSummary.Remaining left</span>
                            </span>
                        }
                        else
                        {
                            <span class="ui-group-row-title">Getting started</span>
                        }
                        <span class="ui-group-row-desc">Step-by-step setup path for new users.</span>
                    </span>
                </span>
                <span class="ui-group-row-chevron" aria-hidden="true">›</span>
            </NavLink>
        </nav>

        <p class="module-section-kicker">Browse by module</p>

        <nav class="ui-group" aria-label="Help modules">
            @foreach (var module in HelpCatalog.Modules)
            {
                <NavLink class="ui-group-row" href="@module.Href">
                    <span class="ui-group-row-leading">
                        <NavIcon Name="@module.Icon" CssClass="ui-group-row-icon" />
                        <span>
                            <span class="ui-group-row-title">@module.Title</span>
                            <span class="ui-group-row-desc">@module.Lead</span>
                        </span>
                    </span>
                    <span class="ui-group-row-chevron" aria-hidden="true">›</span>
                </NavLink>
            }
        </nav>
    </div>
</SettingsShell>

@code {
    private OnboardingProgressSummary? _onboardingSummary;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var completed = await OnboardingProgress.GetCompletedIdsAsync();
        _onboardingSummary = OnboardingProgress.Summarize(completed);
        StateHasChanged();
    }
}
