@page "/login"
@layout LoginLayout
@inject Repository Repo
@inject NavigationManager Nav
@inject MockSessionPersistence SessionPersistence

<PageTitle>Sign in</PageTitle>

@if (!_browserReady)
{
    <p class="login-loading">Loading…</p>
}
else if (Repo.HasMockSession)
{
    <p class="login-loading">Opening chat…</p>
}
else
{
    <div class="login-card">
        <h1 class="login-title">Sign in</h1>
        <p class="login-lead">Use your mailbox email. Password is not checked (demo only).</p>

        <div class="login-field">
            <label class="form-label" for="login-email">Email</label>
            <input id="login-email"
                   type="email"
                   class="form-control login-input"
                   @bind="_email"
                   autocomplete="username"
                   placeholder="you@gmail.com" />
        </div>
        <div class="login-field">
            <label class="form-label" for="login-password">Password</label>
            <input id="login-password"
                   type="password"
                   class="form-control login-input"
                   @bind="_password"
                   autocomplete="current-password"
                   placeholder="Anything" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error" role="alert">@_error</p>
        }

        <button type="button" class="btn btn-primary login-submit" @onclick="ContinueAsync">
            Continue to chat
        </button>
    </div>
}

@code {
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _browserReady;
    private bool _hydrateAttempted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrateAttempted)
        {
            return;
        }

        _hydrateAttempted = true;
        await SessionPersistence.TryRestoreAsync();
        if (Repo.HasMockSession)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        _browserReady = true;
        StateHasChanged();
    }

    private async Task ContinueAsync()
    {
        _error = "";
        var email = _email.Trim();
        if (string.IsNullOrEmpty(email) || email.IndexOf('@') < 0)
        {
            _error = "Enter a valid email address.";
            return;
        }

        try
        {
            Repo.StartMockSession(email, _password);
            await SessionPersistence.SaveEmailAsync(email);
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
            return;
        }
        catch (InvalidOperationException)
        {
            _error = "Could not save session in the browser (try a normal page load, not prerender).";
            return;
        }

        Nav.NavigateTo("/", replace: true);
    }
}
