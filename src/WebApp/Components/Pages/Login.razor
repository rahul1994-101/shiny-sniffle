@page "/login"

@layout LoginLayout

@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

@inject Features Features
@inject CookieAuthenticationService CookieAuth
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Sign in</PageTitle>

@if (!_browserReady)
{
    <p class="login-loading">Loading…</p>
}
else if (_alreadySignedIn)
{
    <p class="login-loading">Opening chat…</p>
}
else
{
    <div class="login-card">
        <h1 class="login-title">Sign in</h1>
        <p class="login-lead">Sign in with the email and password stored for your account.</p>

        <div class="login-field">
            <label class="form-label" for="login-email">Email</label>
            <input id="login-email"
                   type="email"
                   class="form-control login-input"
                   @bind="_email"
                   autocomplete="username"
                   placeholder="you@gmail.com" />
        </div>
        <div class="login-field">
            <label class="form-label" for="login-password">Password</label>
            <input id="login-password"
                   type="password"
                   class="form-control login-input"
                   @bind="_password"
                   autocomplete="current-password"
                   placeholder="Password" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error" role="alert">@_error</p>
        }

        <button type="button" class="btn btn-primary login-submit" @onclick="ContinueAsync">
            Sign in
        </button>
    </div>
}

@code {
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _browserReady;
    private bool _alreadySignedIn;
    private bool _hydrateAttempted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrateAttempted)
        {
            return;
        }

        _hydrateAttempted = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _alreadySignedIn = true;
            StateHasChanged();
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        _browserReady = true;
        StateHasChanged();
    }

    private async Task ContinueAsync()
    {
        _error = "";
        var http = HttpContextAccessor.HttpContext;
        if (http is null)
        {
            _error = "Sign-in is not available (missing HTTP context). Try a full page refresh.";
            return;
        }

        var request = new SignInRequest
        {
            EmailId = _email.Trim(),
            Password = _password,
        };

        var result = await Features.SignInAsync(request);
        if (result.HasError)
        {
            _error = result.Errors.FirstOrDefault()?.Message ?? "Sign-in failed.";
            return;
        }

        if (result.Payload is null)
        {
            _error = "Invalid credentials.";
            return;
        }

        try
        {
            await CookieAuth.SignInAsync(http, result.Payload);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return;
        }

        Nav.NavigateTo("/", forceLoad: true);
    }
}
