@page "/login"

@layout EmptyLayout

@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Antiforgery

@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<PageTitle>Sign in</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <h1 class="login-title">Sign in</h1>
        <p class="login-subtitle">Use your workspace account to continue.</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger login-alert" role="alert">@_errorMessage</div>
        }

        <form method="post" action="@AuthConstants.LoginPostPath">
            @if (_antiforgeryToken is not null)
            {
                <input type="hidden" name="@_antiforgeryToken.FormFieldName" value="@_antiforgeryToken.RequestToken" />
            }

            <input type="hidden" name="@AuthConstants.ReturnUrlQuery" value="@_returnUrl" />

            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input id="email"
                       name="EmailId"
                       type="email"
                       class="form-control login-input"
                       autocomplete="username"
                       placeholder="you@example.com"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input id="password"
                       name="Password"
                       type="password"
                       class="form-control login-input"
                       autocomplete="current-password"
                       placeholder="Password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100 login-submit">Sign in</button>
        </form>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = AuthConstants.ReturnUrlQuery)]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = AuthConstants.ErrorQuery)]
    public string? Error { get; set; }

    private string? _errorMessage;
    private string _returnUrl = AuthConstants.DefaultReturnUrl;
    private AntiforgeryTokenSet? _antiforgeryToken;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            var destination = AuthService.NormalizeReturnUrl(ReturnUrl);
            NavigationManager.NavigateTo(destination, forceLoad: true);
            return;
        }

        _returnUrl = AuthService.NormalizeReturnUrl(ReturnUrl);
        _errorMessage = string.IsNullOrWhiteSpace(Error) ? null : Error;

        if (httpContext is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext);
        }
    }
}
