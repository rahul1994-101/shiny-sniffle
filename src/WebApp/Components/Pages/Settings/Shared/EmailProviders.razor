@inherits BaseComponent

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true" aria-label="Loading email providers">
        <div class="settings-skeleton settings-skeleton-card"></div>
    </div>
}
else
{
    <SettingsEditorHost Layout="_editorLayout"
                        LayoutChanged="OnEditorLayoutChangedAsync"
                        LayoutPreferenceKey="email-providers"
                        EditorOpen="_editorOpen"
                        EditorTitle="@EditorTitle"
                        ListTitle="Provider catalog"
                        ListLead="System templates are read-only. Add custom templates for your own IMAP/SMTP servers."
                        BackLabel="Back to providers"
                        CloseAriaLabel="Close provider editor"
                        ListHeaderActionsAriaLabel="Provider catalog actions"
                        OnRequestClose="CancelEditorAsync">
        <ListHeaderActions>
            @if (_providers.Count > 0)
            {
                <SettingsHeadActionButton Label="Add provider"
                                        AriaLabel="Add provider"
                                        Disabled="@IsFormBusy"
                                        OnClick="BeginAdd" />
            }
        </ListHeaderActions>
        <ListContent>
            @if (_providers.Count == 0)
            {
                <div class="ui-empty-state">
                    <p class="ui-empty-state-title">No providers yet</p>
                    <p class="ui-empty-state-lead">Add a custom template with your IMAP and SMTP server settings.</p>
                    <button type="button"
                            class="ui-btn ui-btn-primary"
                            disabled="@IsFormBusy"
                            @onclick="BeginAdd">
                        Add provider
                    </button>
                </div>
            }
            else
            {
                <div class="ui-group" aria-label="Email providers">
                    @foreach (var provider in _providers)
                    {
                        var rowActive = _editorOpen && _form.Id == provider.Id;
                        <div class="ui-group-row ui-group-row-static ui-list-row-rich @(rowActive ? "settings-editor-row-active" : null)">
                            <div class="ui-list-row-rich-body">
                                <span class="ui-list-row-meta">
                                    <span class="ui-group-row-title">@provider.Name</span>
                                    @if (provider.IsSystem)
                                    {
                                        <span class="ui-list-row-badge">System</span>
                                    }
                                    @if (!IsProviderConfigured(provider))
                                    {
                                        <span class="ui-list-row-badge">Incomplete</span>
                                    }
                                </span>
                                <span class="ui-group-row-desc">
                                    IMAP @provider.ImapHost:@provider.ImapPort @(provider.ImapUseSsl ? "SSL" : "plain") · SMTP @provider.SmtpHost:@provider.SmtpPort @(provider.SmtpUseSsl ? "SSL" : "plain")
                                </span>
                            </div>
                            <div class="ui-list-row-rich-actions">
                                <button type="button"
                                        class="ui-btn ui-btn-secondary ui-btn-sm"
                                        disabled="@IsFormBusy"
                                        @onclick="() => BeginEdit(provider)">
                                    @(provider.IsSystem ? "View" : "Edit")
                                </button>
                                @if (!provider.IsSystem)
                                {
                                    <button type="button"
                                            class="ui-btn ui-btn-danger ui-btn-sm"
                                            disabled="@IsFormBusy"
                                            @onclick="() => DeleteAsync(provider)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ListContent>
        <ListStatus>
            @if (_status.Current is not null)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                   role="status"
                   aria-live="polite">
                    <span class="ui-status-pill-label">@_status.Current.Message</span>
                </p>
            }
        </ListStatus>
        <EditorContent>
            @EditorFields
        </EditorContent>
        <EditorFooter>
            <div class="settings-card-footer settings-actions">
                @if (!_editorReadOnly)
                {
                    <button type="button"
                            class="ui-btn ui-btn-primary"
                            disabled="@(!CanSaveEditor)"
                            @onclick="SaveEditorAsync">
                        @(_saving ? "Saving…" : "Save provider")
                    </button>
                }
                <button type="button"
                        class="@(_editorReadOnly ? "ui-btn ui-btn-primary" : "ui-btn ui-btn-secondary")"
                        disabled="@IsFormBusy"
                        @onclick="CancelEditorAsync">
                    @(_editorReadOnly ? "Close" : "Cancel")
                </button>
            </div>

            @if (_status.Current is not null && _editorOpen)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                   role="status"
                   aria-live="polite">
                    <span class="ui-status-pill-label">@_status.Current.Message</span>
                </p>
            }
        </EditorFooter>
    </SettingsEditorHost>
}

@code {
    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private bool _deleting;
    private bool _editorOpen;
    private SettingsEditorLayout _editorLayout = SettingsEditorLayout.FullPage;
    private readonly List<EmailProviderDto> _providers = [];
    private ProviderForm _form = new();
    private SettingsSectionStatusHandle _status = null!;

    private bool IsFormBusy => _saving || _deleting;

    private bool _editorReadOnly;

    private bool IsFieldDisabled => IsFormBusy || _editorReadOnly;

    private bool CanSaveEditor =>
        !IsFormBusy
        && !_editorReadOnly
        && !string.IsNullOrWhiteSpace(_form.Name)
        && !string.IsNullOrWhiteSpace(_form.ImapHost)
        && !string.IsNullOrWhiteSpace(_form.SmtpHost)
        && IsValidPort(_form.ImapPort)
        && IsValidPort(_form.SmtpPort);

    private string EditorTitle =>
        _form.Id is null
            ? "New provider"
            : _editorReadOnly
                ? $"View {_form.Name}"
                : $"Edit {_form.Name}";

    private static readonly SettingsDropdownField.SettingsDropdownOption[] SslOptions =
    [
        new("ssl", "SSL"),
        new("plain", "Plain")
    ];

    private static readonly SettingsDropdownField.SettingsDropdownOption[] DefaultOptions =
    [
        new("default", "Yes"),
        new("no", "No")
    ];

    private string ImapSslSelect
    {
        get => _form.ImapUseSsl ? "ssl" : "plain";
        set
        {
            _form.ImapUseSsl = string.Equals(value, "ssl", StringComparison.Ordinal);
        }
    }

    private string SmtpSslSelect
    {
        get => _form.SmtpUseSsl ? "ssl" : "plain";
        set
        {
            _form.SmtpUseSsl = string.Equals(value, "ssl", StringComparison.Ordinal);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    private RenderFragment EditorFields => __builder =>
    {
        <div class="settings-editor-form">
            @if (_editorReadOnly)
            {
                <p class="settings-hint" role="status">System template — read only. Server settings are updated with product releases.</p>
            }
            <div class="settings-field">
                <div class="settings-label-row">
                    <label class="settings-label" for="ep-name">Name</label>
                    <FieldHint AriaLabel="Name help">
                        Label shown when picking a provider for a mailbox.
                    </FieldHint>
                </div>
                <input id="ep-name" type="text" class="settings-input" @bind="_form.Name" disabled="@IsFieldDisabled" />
            </div>
            <div class="settings-mail-server">
                <div class="settings-endpoint-row">
                    <div class="settings-field">
                        <label class="settings-label" for="ep-imap-host">IMAP host</label>
                        <input id="ep-imap-host" type="text" class="settings-input" @bind="_form.ImapHost" disabled="@IsFieldDisabled" />
                    </div>
                    <div class="settings-endpoint-port-ssl">
                        <div class="settings-field settings-field-port">
                            <label class="settings-label" for="ep-imap-port">IMAP port</label>
                            <input id="ep-imap-port" type="number" class="settings-input" @bind="_form.ImapPort" disabled="@IsFieldDisabled" />
                        </div>
                        <SettingsDropdownField Label="IMAP SSL"
                                               CssClass="settings-field-ssl"
                                               @bind-Value="ImapSslSelect"
                                               Options="SslOptions"
                                               Disabled="@IsFieldDisabled" />
                    </div>
                </div>
                <div class="settings-endpoint-row">
                    <div class="settings-field">
                        <label class="settings-label" for="ep-smtp-host">SMTP host</label>
                        <input id="ep-smtp-host" type="text" class="settings-input" @bind="_form.SmtpHost" disabled="@IsFieldDisabled" />
                    </div>
                    <div class="settings-endpoint-port-ssl">
                        <div class="settings-field settings-field-port">
                            <label class="settings-label" for="ep-smtp-port">SMTP port</label>
                            <input id="ep-smtp-port" type="number" class="settings-input" @bind="_form.SmtpPort" disabled="@IsFieldDisabled" />
                        </div>
                        <SettingsDropdownField Label="SMTP SSL"
                                               CssClass="settings-field-ssl"
                                               @bind-Value="SmtpSslSelect"
                                               Options="SslOptions"
                                               Disabled="@IsFieldDisabled" />
                    </div>
                </div>
            </div>
        </div>
    };

    private void BeginAdd()
    {
        _status.Clear();
        _editorReadOnly = false;
        _form = new ProviderForm();
        _editorOpen = true;
    }

    private void BeginEdit(EmailProviderDto provider)
    {
        _status.Clear();
        _form = ProviderForm.FromDto(provider);
        _editorReadOnly = provider.IsSystem;
        _editorOpen = true;
    }

    private Task CancelEditorAsync()
    {
        CloseEditor();
        return Task.CompletedTask;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editorReadOnly = false;
        _form = new ProviderForm();
        _status.Clear();
    }

    private Task OnEditorLayoutChangedAsync(SettingsEditorLayout layout)
    {
        _editorLayout = layout;
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        _status.Clear();

        var result = await Mediator.SendAsync(new GetAllEmailProvidersByUserIdRequest(CurrentUser.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to load email providers.",
                isError: true);
            _providers.Clear();
        }
        else
        {
            _providers.Clear();
            _providers.AddRange(result.Payload.Providers);
        }

        _busy = TabBusy.None;
    }

    private static bool IsProviderConfigured(EmailProviderDto provider) =>
        EmailProviderCatalog.ValidateCatalogEndpoints(provider) is null;

    private static bool IsValidPort(int port) => port is >= 1 and <= 65535;

    private async Task SaveEditorAsync()
    {
        _saving = true;
        _status.Clear();

        var dto = _form.ToSaveDto();
        var result = await Mediator.SendAsync(new SaveEmailProviderRequest(CurrentUser.Id, dto));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to save provider.",
                isError: true);
        }
        else
        {
            _status.Set("Provider saved.", isError: false, autoClear: true);
            CloseEditor();
            await LoadAsync();
        }

        _saving = false;
    }

    private async Task DeleteAsync(EmailProviderDto provider)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Delete provider \"{provider.Name}\"? This cannot be undone.");

        if (!confirm)
        {
            return;
        }

        _deleting = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new DeleteEmailProviderRequest(CurrentUser.Id, provider.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to delete provider.",
                isError: true);
        }
        else
        {
            if (_form.Id == provider.Id)
            {
                CloseEditor();
            }

            await LoadAsync();
        }

        _deleting = false;
    }

    private sealed class ProviderForm
    {
        public Guid? Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public string ImapHost { get; set; } = string.Empty;

        public int ImapPort { get; set; } = 993;

        public bool ImapUseSsl { get; set; } = true;

        public string SmtpHost { get; set; } = string.Empty;

        public int SmtpPort { get; set; } = 587;

        public bool SmtpUseSsl { get; set; } = true;

        public bool IsSystem { get; set; }

        public static ProviderForm FromDto(EmailProviderDto dto) => new()
        {
            Id = dto.Id,
            Name = dto.Name,
            ImapHost = dto.ImapHost,
            ImapPort = dto.ImapPort,
            ImapUseSsl = dto.ImapUseSsl,
            SmtpHost = dto.SmtpHost,
            SmtpPort = dto.SmtpPort,
            SmtpUseSsl = dto.SmtpUseSsl,
            IsSystem = dto.IsSystem
        };

        public SaveEmailProviderDto ToSaveDto() => new()
        {
            Id = Id,
            Name = Name,
            ImapHost = ImapHost,
            ImapPort = ImapPort,
            ImapUseSsl = ImapUseSsl,
            SmtpHost = SmtpHost,
            SmtpPort = SmtpPort,
            SmtpUseSsl = SmtpUseSsl
        };
    }

    private enum TabBusy
    {
        None,
        Loading
    }
}
