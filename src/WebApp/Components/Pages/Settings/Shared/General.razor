@inherits BaseComponent
@implements IDisposable

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true" aria-label="Loading account settings">
        <div class="settings-skeleton settings-skeleton-card"></div>
    </div>
}
else
{
    <div class="settings-sections">
        <section class="settings-card" aria-labelledby="profile-heading">
            <h2 id="profile-heading" class="settings-section-title">Profile</h2>
            <p class="settings-section-lead">Your account details for sign-in and display in the app.</p>

            <div class="settings-profile-header">
                <div class="settings-account-avatar" aria-hidden="true">@Initials()</div>
                <div class="settings-profile-identity">
                    <p class="settings-profile-display">@DisplayName()</p>
                </div>
            </div>

            <div class="settings-name-row">
                <div class="settings-field @(string.IsNullOrWhiteSpace(_firstNameError) ? null : "settings-field-invalid")">
                    <label class="settings-label" for="profile-first-name">First name</label>
                    <input id="profile-first-name"
                           type="text"
                           class="settings-input"
                           @bind="_profile.FirstName"
                           @bind:after="OnProfileEdited"
                           autocomplete="given-name"
                           disabled="@IsSaving" />
                    @if (_firstNameError is not null)
                    {
                        <p class="settings-field-error" role="alert">@_firstNameError</p>
                    }
                </div>
                <div class="settings-field @(string.IsNullOrWhiteSpace(_lastNameError) ? null : "settings-field-invalid")">
                    <label class="settings-label" for="profile-last-name">Last name</label>
                    <input id="profile-last-name"
                           type="text"
                           class="settings-input"
                           @bind="_profile.LastName"
                           @bind:after="OnProfileEdited"
                           autocomplete="family-name"
                           disabled="@IsSaving" />
                    @if (_lastNameError is not null)
                    {
                        <p class="settings-field-error" role="alert">@_lastNameError</p>
                    }
                </div>
            </div>

            <div class="settings-field">
                <div class="settings-label-row">
                    <label class="settings-label" for="profile-email">Email</label>
                    <FieldHint AriaLabel="Email help">
                        Sign-in email cannot be changed here.
                    </FieldHint>
                </div>
                <input id="profile-email"
                       type="email"
                       class="settings-input"
                       value="@_profile.Email"
                       disabled
                       aria-readonly="true" />
            </div>

            <div class="settings-field @(string.IsNullOrWhiteSpace(_mobileError) ? null : "settings-field-invalid")">
                <label class="settings-label" for="profile-mobile">Mobile</label>
                <input id="profile-mobile"
                       type="tel"
                       class="settings-input"
                       @bind="_profile.Mobile"
                       @bind:after="OnProfileEdited"
                       autocomplete="tel"
                       disabled="@IsSaving" />
                @if (_mobileError is not null)
                {
                    <p class="settings-field-error" role="alert">@_mobileError</p>
                }
            </div>

            <div class="settings-field @(string.IsNullOrWhiteSpace(_passwordError) ? null : "settings-field-invalid")">
                <div class="settings-label-row">
                    <label class="settings-label" for="profile-password">Password</label>
                    <FieldHint AriaLabel="Password help">
                        @PasswordFieldCopy.ProfileHint
                    </FieldHint>
                </div>
                <div class="settings-password-wrap">
                    <input id="profile-password"
                           type="@(_showPassword ? "text" : "password")"
                           class="settings-input"
                           @bind="_password"
                           @bind:after="OnProfileEdited"
                           autocomplete="new-password"
                           placeholder="@(_profile.HasStoredPassword ? "Saved — leave blank to keep" : "Sign-in password")"
                           disabled="@IsSaving" />
                    <PasswordVisibilityButton Visible="_showPassword"
                                              Disabled="@IsSaving"
                                              OnToggle="@(() => _showPassword = !_showPassword)" />
                </div>
                @if (_passwordError is not null)
                {
                    <p class="settings-field-error" role="alert">@_passwordError</p>
                }
            </div>

            <div class="settings-card-footer">
                <button type="button"
                        class="ui-btn ui-btn-primary"
                        disabled="@(!CanSave)"
                        @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>

            @if (_status.Current is not null)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                   role="status"
                   aria-live="polite">
                    <span class="ui-status-pill-label">@_status.Current.Message</span>
                </p>
            }
        </section>
    </div>
}

@code {
    private GeneralSettingsDto _profile = new();
    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private SettingsSectionStatusHandle _status = null!;
    private string _password = string.Empty;
    private string? _firstNameError;
    private string? _lastNameError;
    private string? _mobileError;
    private string? _passwordError;
    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    public void Dispose() => _status.Dispose();

    #region # Load

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        _status.Clear();

        var result = await Mediator.SendAsync(new GetGeneralSettingsByUserIdRequest(CurrentUser.Id));

        #region # Handle Result

        if (result.HasError)
        {
            _status.Set(
                result.FirstErrorMessage ?? "Failed to load account settings.",
                isError: true);
        }
        else
        {
            _profile = result.Payload;
            _password = string.Empty;
            _showPassword = false;
        }

        #endregion

        _busy = TabBusy.None;
    }

    #endregion

    #region # Save

    private void OnProfileEdited() => ValidateFields();

    private async Task SaveAsync()
    {
        ValidateFields();
        if (_firstNameError is not null || _lastNameError is not null || _mobileError is not null || _passwordError is not null)
        {
            return;
        }

        _saving = true;
        _status.Clear();

        #region # Execute

        var result = await Mediator.SendAsync(new SaveGeneralProfileRequest(
            CurrentUser.Id,
            _profile.FirstName,
            _profile.LastName,
            _profile.Mobile,
            _password));

        #endregion

        #region # Handle Result

        if (result.HasError)
        {
            _status.Set(
                result.FirstErrorMessage ?? "Failed to save profile.",
                isError: true);
        }
        else
        {
            _profile = result.Payload;
            _password = string.Empty;
            _showPassword = false;
            _status.Set("Profile saved.", isError: false, autoClear: true);
            CurrentUser.UpdateDisplayName($"{_profile.FirstName} {_profile.LastName}".Trim());
            await RefreshLayoutAsync();
        }

        #endregion

        _saving = false;
    }

    #endregion

    #region # Helpers

    private void ValidateFields()
    {
        _firstNameError = SettingsFormValidation.ValidateFirstName(_profile.FirstName);
        _lastNameError = SettingsFormValidation.ValidateLastName(_profile.LastName);
        _mobileError = SettingsFormValidation.ValidateMobile(_profile.Mobile);
        _passwordError = SettingsFormValidation.ValidateOptionalPassword(_password);
    }

    private bool IsSaving => _saving;

    private bool CanSave =>
        !IsSaving
        && _firstNameError is null
        && _lastNameError is null
        && _mobileError is null
        && _passwordError is null;

    private string DisplayName()
    {
        var fullName = $"{_profile.FirstName} {_profile.LastName}".Trim();
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        if (!string.IsNullOrWhiteSpace(_profile.Email))
        {
            var local = _profile.Email.Split('@')[0];
            return string.IsNullOrWhiteSpace(local) ? "Your account" : local;
        }

        return "Your account";
    }

    private string Initials()
    {
        var name = DisplayName();
        if (string.IsNullOrWhiteSpace(name) || name == "Your account")
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }

        return char.ToUpperInvariant(name[0]).ToString();
    }

    private enum TabBusy
    {
        None,
        Loading
    }

    #endregion
}
