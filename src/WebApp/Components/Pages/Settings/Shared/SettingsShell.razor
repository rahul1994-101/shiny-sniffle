@inherits BaseComponent

<div class="app-page settings-shell">
    <header class="app-page-header">
        <div class="app-page-header-inner">
            <div class="app-page-head-row">
                <h1 class="app-page-title">@Title</h1>
                @if (ShowHeadAside)
                {
                    <div class="app-page-head-aside">
                        @if (Breadcrumbs is { Count: > 0 })
                        {
                            <nav class="app-page-breadcrumb" aria-label="Breadcrumb">
                                <ol class="app-page-breadcrumb-list">
                                    @foreach (var item in Breadcrumbs)
                                    {
                                        <li class="app-page-breadcrumb-item">
                                            @if (string.IsNullOrEmpty(item.Href))
                                            {
                                                <span>@item.Label</span>
                                            }
                                            else
                                            {
                                                <NavLink href="@item.Href">@item.Label</NavLink>
                                            }
                                        </li>
                                    }
                                    <li class="app-page-breadcrumb-item app-page-breadcrumb-item-current" aria-current="page">
                                        <span>@Title</span>
                                    </li>
                                </ol>
                            </nav>
                        }
                        @if (HasCrossLink)
                        {
                            <NavLink href="@CrossLinkHref"
                                     class="app-page-crosslink"
                                     aria-label="@CrossLinkAriaLabel"
                                     title="@CrossLinkAriaLabel">
                                <NavIcon Name="@CrossLinkIcon" CssClass="app-page-crosslink-icon" />
                            </NavLink>
                        }
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="app-page-subtitle">@Subtitle</p>
            }
        </div>
    </header>

    <div class="app-page-body">
        <div class="app-page-body-inner settings-content">
            @if (Nav is not null)
            {
                <div class="ui-segmented settings-section-nav" role="tablist">
                    @Nav
                </div>
            }
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Settings";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? CrossLinkHref { get; set; }

    [Parameter]
    public NavIconName CrossLinkIcon { get; set; } = NavIconName.Help;

    [Parameter]
    public string? CrossLinkAriaLabel { get; set; }

    [Parameter]
    public IReadOnlyList<SettingsBreadcrumbItem>? Breadcrumbs { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Nav { get; set; }

    private bool HasCrossLink =>
        !string.IsNullOrWhiteSpace(CrossLinkHref) && !string.IsNullOrWhiteSpace(CrossLinkAriaLabel);

    private bool ShowHeadAside =>
        (Breadcrumbs is { Count: > 0 }) || HasCrossLink;
}
