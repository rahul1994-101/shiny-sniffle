@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div @ref="_hostRef"
     class="@RootClass"
     data-editor-layout="@Layout.ToString()"
     data-editing="@(EditorOpen ? "true" : "false")">
    <div class="settings-editor-main">
        <div class="settings-editor-body" @ref="_bodyRef">
        @if (ShowListPane)
        {
            <section class="settings-editor-pane settings-editor-pane-list settings-card"
                     aria-labelledby="@ListHeadingId"
                     aria-hidden="@(HideListFromAccessibility ? true : null)">
                @if (ShowListHeader)
                {
                    <SettingsSectionHead Title="@ListTitle"
                                         HeadingId="@ListHeadingId"
                                         Lead="@ListLead"
                                         LeadContent="@ListLeadContent"
                                         Actions="@ListHeaderActions"
                                         ActionsAriaLabel="@ListHeaderActionsAriaLabel" />
                }

                @ListContent

                @if (ListFooter is not null)
                {
                    @ListFooter
                }

                @if (ListStatus is not null && !EditorOpen)
                {
                    @ListStatus
                }
            </section>
        }

        @if (ShowSplitResizeHandle)
        {
            <div class="settings-editor-split-handle"
                 data-split-handle
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="Resize panels"
                 tabindex="0"></div>
        }

        @if (Layout == SettingsEditorLayout.Dialog)
        {
            <dialog @ref="_dialogElement"
                    class="ui-dialog settings-editor-dialog"
                    aria-labelledby="@EditorHeadingId"
                    @onclose="HandleDialogClose">
                <div class="ui-dialog-panel app-glass-panel">
                    <header class="ui-dialog-header settings-editor-header">
                        <h2 id="@EditorHeadingId" class="ui-dialog-title">@EditorTitle</h2>
                        @EditorCloseButton
                    </header>
                    <div class="ui-dialog-body settings-editor-dialog-body">
                        @EditorContent
                    </div>
                    @if (EditorFooter is not null)
                    {
                        <div class="ui-dialog-footer settings-editor-dialog-footer">
                            @EditorFooter
                        </div>
                    }
                </div>
            </dialog>
        }
        else if (ShowInlineEditorPane)
        {
            <section class="settings-editor-pane settings-editor-pane-editor settings-card"
                     aria-labelledby="@EditorHeadingId">
                <header class="settings-editor-header">
                    <h2 id="@EditorHeadingId" class="settings-section-title settings-editor-header-title">@EditorTitle</h2>
                    @EditorCloseButton
                </header>
                <div class="settings-editor-pane-scroll">
                    @EditorContent
                </div>
                @if (EditorFooter is not null)
                {
                    <div class="settings-editor-pane-footer">
                        @EditorFooter
                    </div>
                }
            </section>
        }
    </div>
    </div>

    @if (ShowLayoutPicker)
    {
        <footer class="settings-editor-layout-picker" role="region" aria-label="Editor layout preview">
            <div class="settings-editor-layout-picker-inner">
            <p class="settings-editor-layout-picker-label">
                Editor layout
                <span class="settings-editor-layout-picker-hint">Preview — pick one for this page later</span>
            </p>
            <div class="ui-segmented settings-editor-layout-segmented" role="group" aria-label="Editor layout mode">
                <button type="button"
                        class="ui-segmented-btn @(Layout == SettingsEditorLayout.FullPage ? "ui-segmented-btn-active" : null)"
                        aria-pressed="@(Layout == SettingsEditorLayout.FullPage)"
                        @onclick="() => SetLayout(SettingsEditorLayout.FullPage)">
                    Full page
                </button>
                <button type="button"
                        class="ui-segmented-btn @(Layout == SettingsEditorLayout.Dialog ? "ui-segmented-btn-active" : null)"
                        aria-pressed="@(Layout == SettingsEditorLayout.Dialog)"
                        @onclick="() => SetLayout(SettingsEditorLayout.Dialog)">
                    Dialog
                </button>
                <button type="button"
                        class="ui-segmented-btn @(Layout == SettingsEditorLayout.SplitPane ? "ui-segmented-btn-active" : null)"
                        aria-pressed="@(Layout == SettingsEditorLayout.SplitPane)"
                        @onclick="() => SetLayout(SettingsEditorLayout.SplitPane)">
                    Split pane
                </button>
            </div>
            </div>
        </footer>
    }
</div>

@code {
    private ElementReference _hostRef;
    private ElementReference _bodyRef;
    private ElementReference _dialogElement;
    private bool _layoutPreferenceLoaded;
    private SettingsEditorLayout _lastSyncedLayout = (SettingsEditorLayout)(-1);
    private bool _lastSyncedEditorOpen;

    [Parameter]
    public SettingsEditorLayout Layout { get; set; } = SettingsEditorLayout.FullPage;

    [Parameter]
    public bool EditorOpen { get; set; }

    [Parameter]
    public string EditorTitle { get; set; } = "Edit";

    [Parameter]
    public string ListTitle { get; set; } = string.Empty;

    [Parameter]
    public string? ListLead { get; set; }

    [Parameter]
    public RenderFragment? ListLeadContent { get; set; }

    [Parameter]
    public RenderFragment? ListHeaderActions { get; set; }

    [Parameter]
    public string ListHeaderActionsAriaLabel { get; set; } = "Section actions";

    [Parameter]
    public string BackLabel { get; set; } = "Back";

    [Parameter]
    public string CloseAriaLabel { get; set; } = "Close editor";

    [Parameter]
    public bool ShowLayoutPicker { get; set; } = true;

    /// <summary>Per-page sessionStorage key for layout preview (e.g. <c>email-providers</c>).</summary>
    [Parameter]
    public string? LayoutPreferenceKey { get; set; }

    [Parameter]
    public EventCallback<SettingsEditorLayout> LayoutChanged { get; set; }

    [Parameter]
    public EventCallback OnRequestClose { get; set; }

    [Parameter]
    public RenderFragment? ListContent { get; set; }

    [Parameter]
    public RenderFragment? ListFooter { get; set; }

    [Parameter]
    public RenderFragment? ListStatus { get; set; }

    [Parameter]
    public RenderFragment? EditorContent { get; set; }

    [Parameter]
    public RenderFragment? EditorFooter { get; set; }

    [Parameter]
    public string? AdditionalHostClass { get; set; }

    private string ListHeadingId { get; } = $"settings-editor-list-{Guid.NewGuid():N}";

    private string EditorHeadingId { get; } = $"settings-editor-form-{Guid.NewGuid():N}";

    private string RootClass =>
        string.Join(
            ' ',
            "settings-editor-host",
            Layout.ToLayoutClass(),
            EditorOpen ? "is-editing" : null,
            ShowLayoutPicker ? "settings-editor-host--layout-preview" : null,
            AdditionalHostClass);

    private bool ShowListPane =>
        Layout switch
        {
            SettingsEditorLayout.FullPage => !EditorOpen,
            SettingsEditorLayout.Dialog => true,
            SettingsEditorLayout.SplitPane => true,
            _ => true
        };

    private bool ShowInlineEditorPane =>
        EditorOpen && Layout is SettingsEditorLayout.FullPage or SettingsEditorLayout.SplitPane;

    private bool ShowSplitResizeHandle =>
        Layout == SettingsEditorLayout.SplitPane && EditorOpen;

    private bool HideListFromAccessibility =>
        Layout == SettingsEditorLayout.FullPage && EditorOpen;

    private bool ShowListHeader =>
        !string.IsNullOrWhiteSpace(ListTitle)
        || ListLeadContent is not null
        || !string.IsNullOrWhiteSpace(ListLead)
        || ListHeaderActions is not null;

    private RenderFragment EditorCloseButton => __builder =>
    {
        <button type="button"
                class="ui-btn ui-btn-secondary ui-btn-icon settings-editor-close"
                aria-label="@CloseAriaLabel"
                title="@CloseAriaLabel"
                @onclick="RequestCloseAsync">
            <svg class="settings-editor-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" />
            </svg>
        </button>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadLayoutPreferenceAsync();
        }

        if (_lastSyncedLayout != Layout || _lastSyncedEditorOpen != EditorOpen)
        {
            await SyncEditorChromeAsync();
            _lastSyncedLayout = Layout;
            _lastSyncedEditorOpen = EditorOpen;
        }
    }

    private async Task LoadLayoutPreferenceAsync()
    {
        if (_layoutPreferenceLoaded || !ShowLayoutPicker || string.IsNullOrWhiteSpace(LayoutPreferenceKey))
        {
            return;
        }

        _layoutPreferenceLoaded = true;

        try
        {
            var stored = await JsRuntime.InvokeAsync<string?>(
                "settingsEditorDialog.getLayoutPreference",
                LayoutPreferenceKey);

            if (Enum.TryParse<SettingsEditorLayout>(stored, ignoreCase: true, out var layout)
                && layout != Layout
                && LayoutChanged.HasDelegate)
            {
                await LayoutChanged.InvokeAsync(layout);
            }
        }
        catch (Exception ex) when (IsBenignJsInterop(ex))
        {
            /* prerender / disconnect */
        }
    }

    private async Task SyncEditorChromeAsync()
    {
        try
        {
            if (Layout == SettingsEditorLayout.Dialog)
            {
                await SyncDialogAsync();
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("settingsEditorDialog.closeOpenDialogs");
            }

            if (Layout == SettingsEditorLayout.SplitPane && EditorOpen)
            {
                await JsRuntime.InvokeVoidAsync("settingsEditorSplit.wire", _hostRef);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("settingsEditorSplit.unwire", _hostRef);
            }
        }
        catch (Exception ex) when (IsBenignJsInterop(ex))
        {
            /* teardown or transient element refs */
        }
    }

    private static bool IsBenignJsInterop(Exception ex) =>
        ex is JSDisconnectedException or ObjectDisposedException or JSException or InvalidOperationException;

    private async Task SyncDialogAsync()
    {
        if (_dialogElement.Context is null)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("settingsEditorDialog.syncOpen", _dialogElement, EditorOpen);
        }
        catch (Exception ex) when (IsBenignJsInterop(ex))
        {
            /* dialog unmounted mid-transition */
        }
    }

    private async Task RequestCloseAsync()
    {
        if (OnRequestClose.HasDelegate)
        {
            await OnRequestClose.InvokeAsync();
        }
    }

    private async Task HandleDialogClose()
    {
        await RequestCloseAsync();
    }

    private async Task SetLayout(SettingsEditorLayout layout)
    {
        if (Layout == layout)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("settingsEditorDialog.closeOpenDialogs");
            await JsRuntime.InvokeVoidAsync("settingsEditorSplit.unwire", _hostRef);
        }
        catch (Exception ex) when (IsBenignJsInterop(ex))
        {
            /* ignore */
        }

        if (LayoutChanged.HasDelegate)
        {
            await LayoutChanged.InvokeAsync(layout);
        }

        _lastSyncedLayout = (SettingsEditorLayout)(-1);

        if (ShowLayoutPicker && !string.IsNullOrWhiteSpace(LayoutPreferenceKey))
        {
            try
            {
                await JsRuntime.InvokeVoidAsync(
                    "settingsEditorDialog.setLayoutPreference",
                    LayoutPreferenceKey,
                    layout.ToString());
            }
            catch (Exception ex) when (IsBenignJsInterop(ex))
            {
                /* prerender */
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("settingsEditorDialog.closeOpenDialogs");
            await JsRuntime.InvokeVoidAsync("settingsEditorSplit.unwire", _hostRef);
        }
        catch (Exception ex) when (IsBenignJsInterop(ex))
        {
            /* teardown */
        }
    }
}
