@page "/settings"
@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Settings</PageTitle>

<SettingsShell Title="Settings"
               Subtitle="Choose an area to configure."
               UseDirtyGuard="false">
    <div class="settings-sections">
        <nav class="ui-group" aria-label="Settings areas">
            @foreach (var area in _areas)
            {
                <NavLink class="ui-group-row" href="@area.Href">
                    <span class="ui-group-row-leading">
                        <NavIcon Name="@area.Icon" CssClass="ui-group-row-icon" />
                        <span>
                            <span class="ui-group-row-title">@area.Title</span>
                            <span class="ui-group-row-desc">@area.Lead</span>
                        </span>
                    </span>
                    <span class="ui-group-row-chevron" aria-hidden="true">›</span>
                </NavLink>
            }
        </nav>

        <div class="ui-group" aria-label="Placeholder">
            @foreach (var row in _placeholderRows)
            {
                <div class="ui-group-row ui-group-row-static">
                    <span>
                        <span class="ui-group-row-title">@row.Title</span>
                        <span class="ui-group-row-desc">@row.Lead</span>
                    </span>
                </div>
            }
        </div>
    </div>
</SettingsShell>

@code {
    private static readonly SettingsArea[] _areas =
    [
        new("/settings/general", "General", "Profile and sign-in password.", NavIconName.General),
        new("/settings/appearance", "Appearance", "Color theme for this device.", NavIconName.Appearance),
        new("/settings/email/providers", "Email", "IMAP/SMTP provider templates.", NavIconName.EmailProviders)
    ];

    private static readonly (string Title, string Lead)[] _placeholderRows =
    [
        ("Lorem ipsum", "Dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor."),
        ("Ut enim ad minim", "Quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea."),
        ("Duis aute irure", "Dolor in reprehenderit in voluptate velit esse cillum dolore.")
    ];

    private sealed record SettingsArea(string Href, string Title, string Lead, NavIconName Icon);
}
