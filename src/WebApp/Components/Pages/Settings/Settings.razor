@page "/settings"
@page "/settings/{Tab}"

@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Settings</PageTitle>

<div class="settings-shell">
    <div class="settings-inner settings-grid">
        <header class="settings-header">
            <h1 class="settings-title">Settings</h1>
            <p class="settings-subtitle">
                @(IsEmailTab ? "Connect IMAP/SMTP for the Email agent." : "Manage your profile and sign-in password.")
            </p>
        </header>

        <nav class="settings-tabs" aria-label="Settings sections">
            <NavLink class="settings-tab" href="/settings/general" Match="NavLinkMatch.All" ActiveClass="settings-tab-active">
                General
            </NavLink>
            <NavLink class="settings-tab" href="/settings/email" Match="NavLinkMatch.All" ActiveClass="settings-tab-active">
                Email
            </NavLink>
        </nav>

        <div class="settings-content">
            @if (IsEmailTab)
            {
                <Email />
            }
            else
            {
                <General />
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Tab))
        {
            NavigationManager.NavigateTo("/settings/general", replace: true);
        }
    }

    private bool IsEmailTab =>
        string.Equals(Tab, "email", StringComparison.OrdinalIgnoreCase);
}
