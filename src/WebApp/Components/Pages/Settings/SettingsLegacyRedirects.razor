@page "/settings/email"
@page "/settings/email-providers"
@page "/settings/email/accounts"
@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Settings</PageTitle>

@code {
    protected override void OnInitialized()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        var target = string.Equals(path, "settings/email/accounts", StringComparison.OrdinalIgnoreCase)
            ? "/workspace/email/accounts"
            : "/settings/email/providers";

        NavigationManager.NavigateTo(target, replace: true);
    }
}
