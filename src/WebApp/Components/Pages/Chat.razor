@page "/chat/{ThreadId:guid?}"

@implements IAsyncDisposable

@inject Features F
@inject NavigationManager Nav
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using WebApp.Utilities.Helpers

<PageTitle>Chat</PageTitle>

<div class="chat-shell">
    <div class="chat-messages" @ref="_messagesRegion">
        @if (_messages.Count == 0)
        {
            <div class="chat-empty">
                <div class="chat-empty-mark" aria-hidden="true"></div>
                <h2 class="chat-empty-title">How can I help you today?</h2>
                <p class="chat-empty-hint">Choose a chat in the sidebar or start below. Each thread is separate until you refresh.</p>
            </div>
        }
        else
        {
            @foreach (var msg in _messages)
            {
                if (IsUser(msg.Role))
                {
                    <div class="msg-row msg-row-user">
                        <div class="msg-chunk msg-chunk-user">
                            <div class="msg-bubble msg-bubble-user">
                                <span class="visually-hidden">You</span>
                                <div class="msg-text">@msg.Content</div>
                            </div>
                            <div class="msg-avatar msg-avatar-user" aria-hidden="true">You</div>
                        </div>
                    </div>
                }
                else if (msg.Role == "system")
                {
                    <div class="msg-row msg-row-system">
                        <div class="msg-system-banner">
                            <span class="msg-system-label">System</span>
                            <div class="msg-text msg-text-system msg-markdown">@ChatMarkdown.ToSanitizedHtml(msg.Content)</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="msg-row msg-row-assistant">
                        <div class="msg-chunk msg-chunk-assistant">
                            <div class="msg-avatar msg-avatar-assistant" aria-hidden="true">AI</div>
                            <div class="msg-bubble msg-bubble-assistant">
                                <span class="visually-hidden">Assistant</span>
                                <div class="msg-text msg-markdown">@ChatMarkdown.ToSanitizedHtml(msg.Content)</div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>

    <div class="chat-composer-wrap">
        <div class="chat-composer">
            <textarea @ref="_input"
                      @bind="_draft"
                      @bind:event="oninput"
                      class="chat-input"
                      rows="1"
                      placeholder="Message…"
                      aria-label="Message"></textarea>
            <button type="button"
                    class="chat-send"
                    @onclick="SendAsync"
                    disabled="@string.IsNullOrWhiteSpace(_draft)"
                    title="Send (Enter)">
                <svg class="chat-send-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
            </button>
        </div>
        <p class="chat-disclaimer">
            Enter to send · Shift+Enter for a new line
        </p>
    </div>
</div>

@code {
    [CascadingParameter(Name = "NotifyLayoutRefresh")]
    public EventCallback NotifyLayoutRefresh { get; set; }

    [Parameter]
    public Guid? ThreadId { get; set; }

    private Guid _activeThreadId;
    private List<GetChatMessageResponse> _messages = [];

    private ElementReference _messagesRegion;
    private ElementReference _input;
    private string _draft = string.Empty;
    private DotNetObjectReference<Chat>? _dotNetRef;
    private bool _enterWired;
    private bool _didNormalizeRoute;
    private string? _routeKey;

    protected override async Task OnParametersSetAsync()
    {
        var key = ThreadId?.ToString("D") ?? "";
        if (_routeKey != key)
        {
            _routeKey = key;
            _didNormalizeRoute = false;
        }

        var previousThreadId = _activeThreadId;
        _activeThreadId = await ResolveActiveThreadIdAsync();

        if (previousThreadId != _activeThreadId)
        {
            await LoadMessagesAsync();
        }
    }

    private async Task LoadMessagesAsync()
    {
        var result = await F.GetChatMessagesByThreadIdAsync(new GetChatMessagesByThreadIdRequest { ThreadId = _activeThreadId });
        _messages = result.Payload ?? [];
    }

    private async Task<Guid> ResolveActiveThreadIdAsync()
    {
        if (ThreadId is { } tid)
        {
            var byId = await F.GetChatThreadByIdAsync(new GetChatThreadByIdRequest { Id = tid });
            if (!byId.HasError && byId.Payload is not null)
            {
                return byId.Payload.Id;
            }
        }

        var threads = await F.GetChatThreadsByUserIdAsync(new GetChatThreadsByUserIdRequest { UserId = CurrentUser.Id });
        if (threads.Payload is { Count: > 0 } existing)
        {
            return existing[0].Id;
        }

        var created = await F.AddChatThreadAsync(new AddChatThreadRequest { Title = "New chat", UserId = CurrentUser.Id });
        return created.Payload?.Id ?? Guid.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_didNormalizeRoute)
        {
            _didNormalizeRoute = true;
            if (ThreadId != _activeThreadId)
            {
                Nav.NavigateTo($"/chat/{_activeThreadId}", replace: true);
                return;
            }
        }

        if (!_enterWired)
        {
            _enterWired = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("webAppChat.wireEnter", _input, _dotNetRef);
            }
            catch (JSException)
            {
            }
        }
    }

    [JSInvokable]
    public Task SendFromJsAsync() => SendAsync();

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        _draft = string.Empty;

        var userResult = await F.AddChatMessageAsync(new AddChatMessageRequest
        {
            ThreadId = _activeThreadId,
            Role = "user",
            Content = text,
            UserId = CurrentUser.Id
        });
        if (!userResult.HasError && userResult.Payload is not null)
        {
            _messages.Add(new GetChatMessageResponse
            {
                Id = userResult.Payload.Id,
                ThreadId = userResult.Payload.ThreadId,
                Role = userResult.Payload.Role,
                Content = userResult.Payload.Content,
                CreatedAt = userResult.Payload.CreatedAt
            });
        }

        var assistantText = AssistantReply(text);
        var assistantResult = await F.AddChatMessageAsync(new AddChatMessageRequest
        {
            ThreadId = _activeThreadId,
            Role = "assistant",
            Content = assistantText,
            UserId = CurrentUser.Id
        });
        if (!assistantResult.HasError && assistantResult.Payload is not null)
        {
            _messages.Add(new GetChatMessageResponse
            {
                Id = assistantResult.Payload.Id,
                ThreadId = assistantResult.Payload.ThreadId,
                Role = assistantResult.Payload.Role,
                Content = assistantResult.Payload.Content,
                CreatedAt = assistantResult.Payload.CreatedAt
            });
        }

        if (NotifyLayoutRefresh.HasDelegate)
        {
            await NotifyLayoutRefresh.InvokeAsync();
        }

        await ScrollToEndAsync();
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("webAppScroll.scrollElementToEnd", _messagesRegion);
        }
        catch
        {
        }
    }

    private static bool IsUser(string role) => role == "user";

    private string AssistantReply(string userMessage)
    {
        var preview = userMessage.Length > 90 ? userMessage[..90].Trim() + "…" : userMessage.Trim();
        return $"Thanks — I received: \"{preview}\". (Local mock reply — replace when the agent API is wired back in.)";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
