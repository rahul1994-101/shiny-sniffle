@page "/settings"

<PageTitle>Settings</PageTitle>

<div class="settings-shell">
    <nav class="settings-back-nav" aria-label="Back">
        <NavLink class="settings-back" href="/">
            <svg class="settings-back-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Back to home
        </NavLink>
    </nav>

    <header class="settings-header">
        <h1 class="settings-title">Settings</h1>
        <p class="settings-subtitle">Workspace preferences.</p>
    </header>

    <section class="settings-card" aria-labelledby="model-heading">
        <h2 id="model-heading" class="settings-section-title">Model</h2>
        <label class="form-label" for="model-id">Label</label>
        <input id="model-id"
               type="text"
               class="form-control settings-input"
               @bind="_vm.ModelName"
               placeholder="e.g. gpt-4.1"
               autocomplete="off" />
        <p class="settings-hint">Display label only; the deployed model is chosen in Azure AI Foundry.</p>
    </section>

    <section class="settings-card" aria-labelledby="appearance-heading">
        <h2 id="appearance-heading" class="settings-section-title">Appearance</h2>
        <label class="form-label" for="theme">Theme</label>
        <select id="theme" class="form-select settings-input" @bind="_vm.Theme">
            <option value="dark">Dark (default)</option>
            <option value="light">Light</option>
            <option value="system">System</option>
        </select>
        <p class="settings-hint">UI theme switching can be hooked up later.</p>
    </section>
</div>

@code {
    private readonly SettingsVM _vm = new();
}
