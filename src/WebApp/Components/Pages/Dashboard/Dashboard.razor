@page "/"

@attribute [Authorize]

@inherits BaseComponent

<PageTitle>Dashboard</PageTitle>

<div class="app-page">
    <header class="app-page-header">
        <div class="app-page-header-inner">
            <h1 class="app-page-title">@Greeting(), @DisplayName()</h1>
            <p class="app-page-subtitle">@DashboardSubtitle()</p>
        </div>
    </header>

    <div class="app-page-body">
        <div class="app-page-body-inner">
            <nav class="ui-group" aria-label="Quick links">
                <NavLink class="ui-group-row" href="settings">
                    <span>
                        <span class="ui-group-row-title">Settings</span>
                        <span class="ui-group-row-desc">Mailbox for the Email agent</span>
                    </span>
                    <span class="ui-group-row-chevron" aria-hidden="true">›</span>
                </NavLink>
                <SignOutForm ButtonClass="ui-group-row ui-group-row-static ui-group-row-danger">
                    <span>
                        <span class="ui-group-row-title">Sign out</span>
                        <span class="ui-group-row-desc">End your session</span>
                    </span>
                </SignOutForm>
            </nav>
        </div>
    </div>
</div>

@code {
    private string DashboardSubtitle()
    {
        var email = CurrentUser.Email?.Trim();
        return string.IsNullOrWhiteSpace(email)
            ? "Pick up a recent chat from the sidebar whenever you are ready."
            : $"Signed in as {email}. Pick up a recent chat from the sidebar whenever you are ready.";
    }

    private string DisplayName()
    {
        if (!string.IsNullOrWhiteSpace(CurrentUser.FullName))
        {
            return CurrentUser.FullName.Trim();
        }

        if (!string.IsNullOrWhiteSpace(CurrentUser.Email))
        {
            var local = CurrentUser.Email.Split('@')[0];
            return string.IsNullOrWhiteSpace(local) ? "there" : local;
        }

        return "there";
    }

    private static string Greeting()
    {
        var hour = DateTime.Now.Hour;
        return hour switch
        {
            < 12 => "Good morning",
            < 17 => "Good afternoon",
            _ => "Good evening"
        };
    }
}
