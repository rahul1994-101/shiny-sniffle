<header class="dash-hero">
    <p class="dash-eyebrow">Dashboard</p>
    <h1 class="dash-title">@Greeting, @DisplayName</h1>
    <p class="dash-lead">
        Signed in as <span class="dash-lead-email">@UserEmail</span>.
        Pick up a recent chat from the sidebar whenever you are ready.
    </p>
</header>

@code {
    [Parameter]
    public string Greeting { get; set; } = string.Empty;

    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter]
    public string? UserEmail { get; set; }
}
