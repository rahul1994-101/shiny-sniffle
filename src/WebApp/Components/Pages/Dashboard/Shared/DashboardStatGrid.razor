<div class="dash-stat-grid" aria-label="Overview">
    <article class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon-threads" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
        </div>
        <div class="dash-stat-body">
            <p class="dash-stat-label">Conversations</p>
            <p class="dash-stat-value">@ThreadCount</p>
        </div>
    </article>

    <article class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon-activity" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
            </svg>
        </div>
        <div class="dash-stat-body">
            <p class="dash-stat-label">Last activity</p>
            <p class="dash-stat-value dash-stat-value-sm">@LastActivityLabel</p>
        </div>
    </article>

    <article class="dash-stat-card">
        <div class="dash-stat-icon dash-stat-icon-account" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        </div>
        <div class="dash-stat-body">
            <p class="dash-stat-label">Signed in as</p>
            <p class="dash-stat-value dash-stat-value-sm" title="@UserEmail">@UserEmail</p>
        </div>
    </article>
</div>

@code {
    [Parameter]
    public int ThreadCount { get; set; }

    [Parameter]
    public string LastActivityLabel { get; set; } = "";

    [Parameter]
    public string? UserEmail { get; set; }
}
