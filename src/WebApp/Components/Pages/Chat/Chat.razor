@page "/chat/{ThreadId:guid?}"

@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Chat</PageTitle>

<div class="chat-shell">
    <div class="chat-messages" @ref="_messagesRegion">
        <ChatMessageList Messages="_messages" />
    </div>

    <div class="chat-composer-wrap">
        <div class="chat-composer">
            <textarea @ref="_input"
                      @bind="_draft"
                      @bind:event="oninput"
                      @bind:after="ResizeComposerAsync"
                      @onkeydown="OnComposerKeyDownAsync"
                      @onkeydown:preventDefault="@_preventEnterNewline"
                      class="chat-input"
                      rows="1"
                      placeholder="Message…"
                      aria-label="Message"></textarea>
            <div class="chat-composer-actions">
                <ChatAgentSelector ThreadId="_activeThreadId"
                                   Value="_chatAgent"
                                   ValueChanged="OnChatAgentChangedAsync" />
                <button type="button"
                        class="chat-send"
                        @onclick="SendAsync"
                        disabled="@string.IsNullOrWhiteSpace(_draft)"
                        title="Send (Enter)">
                    <svg class="chat-send-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                </button>
            </div>
        </div>
        <p class="chat-disclaimer">
            Enter to send · Shift+Enter for a new line
        </p>
    </div>
</div>

@code {
    [Parameter]
    public Guid? ThreadId { get; set; }

    private Guid _activeThreadId;
    private ChatAgent _chatAgent;
    private List<GetChatMessageResponse> _messages = [];

    private ElementReference _messagesRegion;
    private ElementReference _input;
    private string _draft = string.Empty;
    private bool _preventEnterNewline;
    private bool _didNormalizeRoute;
    private bool _resizeComposerAfterRender;
    private string? _routeKey;

    protected override async Task OnParametersSetAsync()
    {
        var key = GetRouteThreadId()?.ToString("D") ?? NavigationManager.Uri;
        if (_routeKey != key)
        {
            _routeKey = key;
            _didNormalizeRoute = false;
        }

        var previousThreadId = _activeThreadId;
        _activeThreadId = await ResolveActiveThreadIdAsync();

        if (previousThreadId != _activeThreadId)
        {
            _draft = string.Empty;
            await LoadThreadContextAsync();
            await LoadMessagesAsync();
            _resizeComposerAfterRender = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_resizeComposerAfterRender)
        {
            return;
        }

        _resizeComposerAfterRender = false;
        await ResizeComposerAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_didNormalizeRoute)
        {
            return;
        }

        _didNormalizeRoute = true;

        if (_activeThreadId == Guid.Empty)
        {
            return;
        }

        if (GetRouteThreadId() != _activeThreadId)
        {
            NavigationManager.NavigateTo($"/chat/{_activeThreadId}", replace: true);
        }
    }


    #region # Thread

    private async Task LoadThreadContextAsync()
    {
        if (_activeThreadId == Guid.Empty)
        {
            return;
        }

        var result = await Features.GetChatThreadByIdAsync(new GetChatThreadByIdRequest { Id = _activeThreadId });
        if (!result.HasError && result.Payload is not null)
        {
            _chatAgent = result.Payload.ChatAgent;
        }
    }

    private Task OnChatAgentChangedAsync(ChatAgent chatAgent)
    {
        _chatAgent = chatAgent;
        return Task.CompletedTask;
    }

    private async Task<Guid> ResolveActiveThreadIdAsync()
    {
        if (GetRouteThreadId() is { } routeThreadId)
        {
            var byId = await Features.GetChatThreadByIdAsync(new GetChatThreadByIdRequest { Id = routeThreadId });
            if (!byId.HasError && byId.Payload is not null)
            {
                return byId.Payload.Id;
            }

            // URL names a thread — keep it on refresh even if lookup fails transiently.
            return routeThreadId;
        }

        var threads = await Features.GetChatThreadsByUserIdAsync(new GetChatThreadsByUserIdRequest { UserId = CurrentUser.Id });
        if (threads.Payload is { Count: > 0 } existing)
        {
            return existing[0].Id;
        }

        var created = await Features.AddChatThreadAsync(new AddChatThreadRequest { Title = "New chat", UserId = CurrentUser.Id });
        return created.Payload?.Id ?? Guid.Empty;
    }

    private Guid? GetRouteThreadId()
    {
        if (ThreadId is { } fromParameter)
        {
            return fromParameter;
        }

        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relative.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        const string prefix = "chat/";
        if (!path.StartsWith(prefix, StringComparison.Ordinal))
        {
            return null;
        }

        var segment = path[prefix.Length..].Trim('/');
        return Guid.TryParse(segment, out var parsed) ? parsed : null;
    }

    #endregion

    #region # Messages

    private async Task OnComposerKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _preventEnterNewline = true;
            await SendAsync();
        }
        else
        {
            _preventEnterNewline = false;
        }
    }

    private async Task LoadMessagesAsync()
    {
        var result = await Features.GetChatMessagesByChatThreadIdAsync(new GetChatMessagesByChatThreadIdRequest { ChatThreadId = _activeThreadId });
        _messages = result.Payload ?? [];
    }

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        _draft = string.Empty;
        await ResizeComposerAsync();

        var userResult = await Features.AddChatMessageAsync(new AddChatMessageRequest
        {
            ChatThreadId = _activeThreadId,
            Role = "user",
            Content = text,
            UserId = CurrentUser.Id
        });
        if (!userResult.HasError && userResult.Payload is not null)
        {
            _messages.Add(new GetChatMessageResponse
            {
                Id = userResult.Payload.Id,
                ChatThreadId = userResult.Payload.ChatThreadId,
                Role = userResult.Payload.Role,
                Content = userResult.Payload.Content,
                CreatedAt = userResult.Payload.CreatedAt
            });
        }

        var assistantText = "Something went wrong while generating a reply.";
        var turnResult = await Features.ProcessChatTurnAsync(new ProcessChatTurnRequest
        {
            ChatThreadId = _activeThreadId,
            UserId = CurrentUser.Id,
            Message = text
        });
        if (!turnResult.HasError && turnResult.Payload is not null)
        {
            assistantText = turnResult.Payload.AssistantContent;
        }

        var assistantResult = await Features.AddChatMessageAsync(new AddChatMessageRequest
        {
            ChatThreadId = _activeThreadId,
            Role = "assistant",
            Content = assistantText,
            UserId = CurrentUser.Id
        });
        if (!assistantResult.HasError && assistantResult.Payload is not null)
        {
            _messages.Add(new GetChatMessageResponse
            {
                Id = assistantResult.Payload.Id,
                ChatThreadId = assistantResult.Payload.ChatThreadId,
                Role = assistantResult.Payload.Role,
                Content = assistantResult.Payload.Content,
                CreatedAt = assistantResult.Payload.CreatedAt
            });
        }

        await RefreshLayoutAsync();
        await ScrollToEndAsync();
    }

    #endregion

    #region # Helpers

    private async Task ResizeComposerAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("webAppChat.resizeTextarea", _input, 3);
        }
        catch
        {
        }
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Yield();
        try
        {
            await JsRuntime.InvokeVoidAsync("webAppScroll.scrollElementToEnd", _messagesRegion);
        }
        catch
        {
        }
    }

    #endregion
}
