@page "/chat/{ThreadId:guid?}"

@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Chat</PageTitle>

<div class="chat-shell">
    <div class="chat-messages" @ref="_messagesRegion">
        <ChatMessageList Messages="_messages" />
    </div>

    <div class="chat-composer-wrap">
        <div class="chat-composer">
            <textarea @ref="_input"
                      @bind="_draft"
                      @bind:event="oninput"
                      @bind:after="ResizeComposerAsync"
                      @onkeydown="OnComposerKeyDownAsync"
                      @onkeydown:preventDefault="@_preventEnterNewline"
                      class="chat-input"
                      rows="1"
                      placeholder="Message…"
                      aria-label="Message"></textarea>
            <div class="chat-composer-actions">
                <ChatAgentSelector ThreadId="_activeThreadId"
                                   @bind-Value="_chatAgent" />
                <button type="button"
                        class="chat-send"
                        @onclick="SendAsync"
                        disabled="@string.IsNullOrWhiteSpace(_draft)"
                        title="Send (Enter)">
                    <svg class="chat-send-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                </button>
            </div>
        </div>
        <p class="chat-disclaimer">
            Enter to send · Shift+Enter for a new line
        </p>
    </div>
</div>

@code {
    [Parameter]
    public Guid? ThreadId { get; set; }

    private Guid _activeThreadId;
    private ChatAgent _chatAgent;
    private List<ChatMessageDto> _messages = [];
    private bool _resizeComposerAfterRender;
    private bool _scrollMessagesAfterRender;

    protected override async Task OnParametersSetAsync()
    {
        // Bare /chat or empty id — chat is only reachable via sidebar (/chat/{id}).
        if (ThreadId is not { } threadId || threadId == Guid.Empty)
        {
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        // Same thread as last render; skip reload.
        if (_activeThreadId == threadId)
        {
            return;
        }

        // Load thread, validate ownership, then switch active thread and messages.
        await LoadThreadContextAsync(threadId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_resizeComposerAfterRender)
        {
            _resizeComposerAfterRender = false;
            await ResizeComposerAsync();
        }

        if (_scrollMessagesAfterRender)
        {
            _scrollMessagesAfterRender = false;
            await ScrollToEndAsync();
        }
    }


    #region # Thread

    private async Task LoadThreadContextAsync(Guid threadId)
    {
        var result = await Mediator.SendAsync(new GetChatThreadByIdRequest(threadId));

        // Missing, deleted, or another user's thread — send home.
        if (result.HasError
            || result.Payload is null
            || result.Payload.UserId != CurrentUser.Id)
        {
            NavigationManager.NavigateTo("/", replace: true);
            return;
        }

        // Valid thread: adopt route id, agent, and message history.
        _activeThreadId = threadId;
        _chatAgent = result.Payload.ChatAgent;
        _draft = string.Empty;

        await LoadMessagesAsync();

        _resizeComposerAfterRender = true;
        _scrollMessagesAfterRender = true;
    }

    #endregion

    #region # Messages

    private string _draft = string.Empty;
    private bool _preventEnterNewline;

    private async Task OnComposerKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _preventEnterNewline = true;
            await SendAsync();
        }
        else
        {
            _preventEnterNewline = false;
        }
    }

    private async Task LoadMessagesAsync()
    {
        var result = await Mediator.SendAsync(new GetChatMessagesByChatThreadIdRequest(_activeThreadId));
        _messages = result.Payload?.Messages ?? [];
    }

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        _draft = string.Empty;
        _resizeComposerAfterRender = true;

        var sendResult = await Mediator.SendAsync(new SendChatMessageRequest(
            _activeThreadId,
            CurrentUser.Id,
            _chatAgent,
            text));
        if (!sendResult.HasError && sendResult.Payload is not null)
        {
            _messages.Add(sendResult.Payload.UserMessage);
            _messages.Add(sendResult.Payload.AssistantMessage);
        }

        await RefreshLayoutAsync();
        _scrollMessagesAfterRender = true;
    }

    #endregion

    #region # Helpers

    private ElementReference _messagesRegion;
    private ElementReference _input;

    private async Task ResizeComposerAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("webAppChat.resizeTextarea", _input, 3);
        }
        catch
        {
        }
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Yield();
        try
        {
            await JsRuntime.InvokeVoidAsync("webAppScroll.scrollElementToEnd", _messagesRegion);
        }
        catch
        {
        }
    }

    #endregion
}
