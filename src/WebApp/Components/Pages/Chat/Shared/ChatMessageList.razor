@if (Messages.Count == 0 && !IsAssistantLoading)
{
    <div class="chat-empty">
        <div class="chat-empty-mark" aria-hidden="true"></div>
        <h2 class="chat-empty-title">@(IsEmail ? "Ready to triage your inbox" : "How can I help you today?")</h2>
        <p class="chat-empty-hint">@(IsEmail
            ? "Ask in your own words or pick a suggestion. Replies, archives, and sends stay in this chat."
            : "Choose a chat in the sidebar or start below. Each thread is separate until you refresh.")</p>
        <EmailTriageStarters Visible="@IsEmail"
                             Disabled="@StarterDisabled"
                             OnPick="OnStarterPick" />
    </div>
}
else
{
    @foreach (var msg in Messages)
    {
        if (msg.Role == ChatMessageRoles.User)
        {
            <div class="msg-row msg-row-user">
                <div class="msg-chunk msg-chunk-user">
                    <div class="msg-bubble msg-bubble-user">
                        <span class="visually-hidden">You</span>
                        <div class="msg-text">
                            <EntityRefMentionText Text="@msg.Content" />
                        </div>
                    </div>
                    <div class="msg-avatar msg-avatar-user" aria-hidden="true">You</div>
                </div>
            </div>
        }
        else if (msg.Role == ChatMessageRoles.System)
        {
            <div class="msg-row msg-row-system">
                <div class="msg-system-banner">
                    <span class="msg-system-label">System</span>
                    <div class="msg-text msg-text-system msg-markdown">@ChatHelpers.ToSanitizedHtml(msg.Content)</div>
                </div>
            </div>
        }
        else
        {
            <div class="msg-row msg-row-assistant">
                <div class="msg-chunk msg-chunk-assistant">
                    <div class="msg-avatar msg-avatar-assistant" aria-hidden="true">AI</div>
                    <div class="msg-bubble msg-bubble-assistant">
                        <span class="visually-hidden">Assistant</span>
                        <div class="msg-text msg-markdown">@ChatHelpers.ToSanitizedHtml(msg.Content)</div>
                    </div>
                </div>
            </div>
        }
    }

    @if (IsAssistantLoading)
    {
        <div class="msg-row msg-row-assistant">
            <div class="msg-chunk msg-chunk-assistant">
                <div class="msg-avatar msg-avatar-assistant" aria-hidden="true">AI</div>
                <div class="msg-bubble msg-bubble-assistant msg-bubble-loading" aria-busy="true">
                    <span class="visually-hidden">Assistant is thinking</span>
                    <div class="msg-typing" aria-hidden="true">
                        <span class="msg-typing-dot"></span>
                        <span class="msg-typing-dot"></span>
                        <span class="msg-typing-dot"></span>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public IReadOnlyList<ChatMessageDto> Messages { get; set; } = [];

    [Parameter]
    public bool IsAssistantLoading { get; set; }

    [Parameter]
    public bool IsEmail { get; set; }

    [Parameter]
    public bool StarterDisabled { get; set; }

    [Parameter]
    public EventCallback<string> OnStarterPick { get; set; }
}
