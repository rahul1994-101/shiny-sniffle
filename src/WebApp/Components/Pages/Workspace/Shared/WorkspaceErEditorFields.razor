<div class="settings-editor-form">
    <div class="settings-field">
        <label class="settings-label" for="@($"{IdPrefix}-name")">Name</label>
        <input id="@($"{IdPrefix}-name")"
               class="settings-input"
               maxlength="@NameMaxLength"
               @bind="Name"
               @bind:event="oninput"
               @bind:after="NotifyNameChangedAsync"
               disabled="@Disabled" />
    </div>
    <div class="settings-field">
        <label class="settings-label" for="@($"{IdPrefix}-color")">
            Color <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
        </label>
        <ColorPicker Id="@($"{IdPrefix}-color")"
                     Value="@Color"
                     ValueChanged="NotifyColorChangedAsync"
                     Disabled="@Disabled" />
    </div>
    <div class="settings-provider-extras">
        <p class="settings-label">@EntityContextFieldCopy.SectionTitle</p>
        <EntityAliasInput InputId="@($"{IdPrefix}-alias")"
                          Kind="Kind"
                          Alias="@Alias"
                          AliasChanged="NotifyAliasChangedAsync"
                          SourcePrimary="@Name"
                          Disabled="Disabled" />
        <div class="settings-field">
            <div class="settings-label-row">
                <label class="settings-label" for="@($"{IdPrefix}-context")">
                    @EntityContextFieldCopy.Label <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                </label>
                <FieldHint AriaLabel="Context help">
                    @EntityContextFieldCopy.Hint
                </FieldHint>
            </div>
            <textarea id="@($"{IdPrefix}-context")"
                      class="settings-input settings-textarea"
                      rows="3"
                      maxlength="2000"
                      @bind="Context"
                      @bind:event="oninput"
                      @bind:after="NotifyContextChangedAsync"
                      disabled="@Disabled"></textarea>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = "item";

    [Parameter]
    public int NameMaxLength { get; set; } = 64;

    [Parameter]
    public EntityRefs.Kind Kind { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> NameChanged { get; set; }

    [Parameter]
    public string? Color { get; set; }

    [Parameter]
    public EventCallback<string?> ColorChanged { get; set; }

    [Parameter]
    public string? Alias { get; set; }

    [Parameter]
    public EventCallback<string?> AliasChanged { get; set; }

    [Parameter]
    public string? Context { get; set; }

    [Parameter]
    public EventCallback<string?> ContextChanged { get; set; }

    // These fields are set locally by their own @bind on the way in, but a plain
    // @bind on a [Parameter] never notifies the parent — it must be forwarded explicitly.
    private Task NotifyNameChangedAsync() => NameChanged.InvokeAsync(Name);

    private Task NotifyContextChangedAsync() => ContextChanged.InvokeAsync(Context);

    private async Task NotifyColorChangedAsync(string? value)
    {
        Color = value;
        await ColorChanged.InvokeAsync(value);
    }

    private async Task NotifyAliasChangedAsync(string? value)
    {
        Alias = value;
        await AliasChanged.InvokeAsync(value);
    }
}
