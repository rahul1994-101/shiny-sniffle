@inherits BaseComponent

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true"><div class="settings-skeleton settings-skeleton-card"></div></div>
}
else
{
    <SettingsEditorHost Layout="_editorLayout"
                        LayoutChanged="OnEditorLayoutChangedAsync"
                        LayoutPreferenceKey="workspace-tags"
                        EditorOpen="_editorOpen"
                        EditorTitle="@EditorTitle"
                        ListTitle="Tags"
                        ListLead="Describe contacts and mailboxes (facets, roles, topics)."
                        BackLabel="Back to tags"
                        CloseAriaLabel="Close tag editor"
                        ListHeaderActionsAriaLabel="Tag list actions"
                        OnRequestClose="CancelEditorAsync">
        <ListHeaderActions>
            @if (_tags.Count > 0)
            {
                <SettingsHeadActionButton Label="Add tag" AriaLabel="Add tag" Disabled="@IsFormBusy" OnClick="BeginAdd" />
            }
        </ListHeaderActions>
        <ListContent>
            @if (_tags.Count == 0)
            {
                <div class="ui-empty-state">
                    <p class="ui-empty-state-title">No tags yet</p>
                    <button type="button" class="ui-btn ui-btn-primary" disabled="@IsFormBusy" @onclick="BeginAdd">Add tag</button>
                </div>
            }
            else
            {
                <div class="ui-group" aria-label="Tags">
                    @foreach (var tag in _tags)
                    {
                        <div class="ui-group-row ui-group-row-static ui-list-row-rich">
                            <div class="ui-list-row-rich-body">
                                <span class="ui-group-row-title" title="@tag.Context">
                                    @if (!string.IsNullOrWhiteSpace(tag.Color))
                                    {
                                        <span class="ui-catalog-swatch" style="background-color: @tag.Color"></span>
                                    }
                                    @tag.Name
                                </span>
                                <span class="ui-group-row-desc">@tag.EntityRef</span>
                            </div>
                            <div class="ui-list-row-rich-actions">
                                <button type="button" class="ui-btn ui-btn-secondary ui-btn-sm" disabled="@IsFormBusy" @onclick="() => BeginEdit(tag)">Edit</button>
                                <button type="button" class="ui-btn ui-btn-danger ui-btn-sm" disabled="@IsFormBusy" @onclick="() => DeleteAsync(tag)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </ListContent>
        <ListStatus>
            @if (_status.Current is not null)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success")" role="status">@_status.Current.Message</p>
            }
        </ListStatus>
        <EditorContent>
            <WorkspaceErEditorFields IdPrefix="tag"
                                     NameMaxLength="64"
                                     ScopePlural="tags"
                                     Kind="@EntityRefs.Kind.Tag"
                                     Disabled="@IsFormBusy"
                                     @bind-Name="_form.Name"
                                     @bind-Color="_form.Color"
                                     @bind-Alias="_form.Alias"
                                     @bind-Context="_form.Context"
                                     EffectiveAlias="@_form.EffectiveAlias"
                                     CanPreviewEntityRef="@_form.CanPreviewEntityRef"
                                     Edited="OnFormEdited" />
        </EditorContent>
        <EditorFooter>
            <div class="settings-card-footer settings-actions">
                <button type="button" class="ui-btn ui-btn-primary" disabled="@(!CanSave)" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save tag")</button>
                <button type="button" class="ui-btn ui-btn-secondary" disabled="@IsFormBusy" @onclick="CancelEditorAsync">Cancel</button>
            </div>
        </EditorFooter>
    </SettingsEditorHost>
}

@code {
    [CascadingParameter]
    public SettingsPageContext PageContext { get; set; } = null!;

    private const string DefaultColor = ColorPickerPresets.Default;

    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private bool _deleting;
    private bool _editorOpen;
    private SettingsEditorLayout _editorLayout = SettingsEditorLayout.FullPage;
    private readonly List<TagDto> _tags = [];
    private TagForm _form = new();
    private TagForm _formBaseline = new();
    private SettingsSectionStatusHandle _status = null!;

    private bool IsFormBusy => _saving || _deleting;

    private bool IsFormDirty => !_form.ContentEquals(_formBaseline);

    private bool CanSave =>
        !IsFormBusy
        && !string.IsNullOrWhiteSpace(_form.Name)
        && IsFormDirty;
    private string EditorTitle => _form.Id is null ? "New tag" : $"Edit {_form.Name}";

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    #region # Load

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        var result = await Mediator.SendAsync(new ListTagsRequest(CurrentUser.Id));
        _tags.Clear();
        if (!result.HasError && result.Payload?.Tags is { } items)
        {
            _tags.AddRange(items);
        }

        _busy = TabBusy.None;
    }

    #endregion

    #region # Editor

    private void BeginAdd()
    {
        _form = new TagForm { Color = DefaultColor };
        CaptureFormBaseline();
        _editorOpen = true;
        SyncDirtyState();
    }

    private void BeginEdit(TagDto tag)
    {
        _form = TagForm.FromDto(tag);
        CaptureFormBaseline();
        _editorOpen = true;
        SyncDirtyState();
    }

    private async Task CancelEditorAsync()
    {
        if (_editorOpen && IsFormDirty
            && !await JsRuntime.InvokeAsync<bool>("confirm", SettingsDirtyGuard.DiscardMessage))
        {
            return;
        }

        CloseEditor();
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _form = new();
        _formBaseline = new();
        SyncDirtyState();
    }

    private void OnFormEdited() => SyncDirtyState();

    private void SyncDirtyState() =>
        PageContext.SetEditorDirty(_editorOpen && IsFormDirty);

    private void CaptureFormBaseline() => _formBaseline = _form.Clone();

    private Task OnEditorLayoutChangedAsync(SettingsEditorLayout layout)
    {
        _editorLayout = layout;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = await Mediator.SendAsync(new SaveTagRequest(CurrentUser.Id, _form.ToDto()));
        if (result.HasError)
        {
            _status.Set(result.Errors.FirstOrDefault()?.Message ?? "Save failed.", isError: true);
        }
        else
        {
            CloseEditor();
            await LoadAsync();
        }

        _saving = false;
    }

    private async Task DeleteAsync(TagDto tag)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Delete tag \"{tag.Name}\"?"))
        {
            return;
        }

        _deleting = true;
        var result = await Mediator.SendAsync(new DeleteTagRequest(CurrentUser.Id, tag.Id));
        if (!result.HasError)
        {
            await LoadAsync();
        }

        _deleting = false;
    }

    #endregion

    #region # Helpers

    private sealed class TagForm
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Alias { get; set; }
        public string? Color { get; set; }
        public string? Context { get; set; }

        public string EffectiveAlias =>
            EntityAliasPreview.FromNameOrAlias(Alias, Name, "tag");

        public bool CanPreviewEntityRef => !string.IsNullOrWhiteSpace(Name) || !string.IsNullOrWhiteSpace(Alias);

        public static TagForm FromDto(TagDto dto) => new()
        {
            Id = dto.Id,
            Name = dto.Name,
            Alias = dto.Alias,
            Color = dto.Color ?? DefaultColor,
            Context = dto.Context
        };

        public SaveTagDto ToDto() => new()
        {
            Id = Id,
            Name = Name.Trim(),
            Alias = string.IsNullOrWhiteSpace(Alias) ? null : Alias.Trim(),
            Color = Color,
            Context = string.IsNullOrWhiteSpace(Context) ? null : Context.Trim()
        };

        public TagForm Clone() => new()
        {
            Id = Id,
            Name = Name,
            Alias = Alias,
            Color = Color,
            Context = Context
        };

        public bool ContentEquals(TagForm other) =>
            Id == other.Id
            && string.Equals(Name, other.Name, StringComparison.Ordinal)
            && string.Equals(Alias ?? "", other.Alias ?? "", StringComparison.Ordinal)
            && string.Equals(Color ?? "", other.Color ?? "", StringComparison.Ordinal)
            && string.Equals(Context ?? "", other.Context ?? "", StringComparison.Ordinal);
    }

    private enum TabBusy { None, Loading }

    #endregion
}
