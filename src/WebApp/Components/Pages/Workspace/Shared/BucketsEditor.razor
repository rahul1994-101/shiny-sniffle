@inherits BaseComponent

@using WebApp.Components.Pages.Settings
@using WebApp.Components.Pages.Settings.Shared
@using Application.Features.workspace.Buckets
@using Application.Features.workspace.Buckets.Commands
@using Application.Features.workspace.Buckets.Queries

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true"><div class="settings-skeleton settings-skeleton-card"></div></div>
}
else
{
    <SettingsEditorHost Layout="_editorLayout"
                        LayoutChanged="OnEditorLayoutChangedAsync"
                        LayoutPreferenceKey="workspace-buckets"
                        EditorOpen="_editorOpen"
                        EditorTitle="@EditorTitle"
                        ListTitle="Buckets"
                        ListLead="Group contacts and mailboxes (e.g. XYZ Inc, Family)."
                        BackLabel="Back to buckets"
                        CloseAriaLabel="Close bucket editor"
                        ListHeaderActionsAriaLabel="Bucket list actions"
                        OnRequestClose="CancelEditorAsync">
        <ListHeaderActions>
            @if (_buckets.Count > 0)
            {
                <SettingsHeadActionButton Label="Add bucket" AriaLabel="Add bucket" Disabled="@IsFormBusy" OnClick="BeginAdd" />
            }
        </ListHeaderActions>
        <ListContent>
            @if (_buckets.Count == 0)
            {
                <div class="ui-empty-state">
                    <p class="ui-empty-state-title">No buckets yet</p>
                    <button type="button" class="ui-btn ui-btn-primary" disabled="@IsFormBusy" @onclick="BeginAdd">Add bucket</button>
                </div>
            }
            else
            {
                <div class="ui-group" aria-label="Buckets">
                    @foreach (var bucket in _buckets)
                    {
                        <div class="ui-group-row ui-group-row-static ui-list-row-rich">
                            <div class="ui-list-row-rich-body">
                                <span class="ui-group-row-title">@bucket.Name</span>
                            </div>
                            <div class="ui-list-row-rich-actions">
                                <button type="button" class="ui-btn ui-btn-secondary ui-btn-sm" disabled="@IsFormBusy" @onclick="() => BeginEdit(bucket)">Edit</button>
                                <button type="button" class="ui-btn ui-btn-danger ui-btn-sm" disabled="@IsFormBusy" @onclick="() => DeleteAsync(bucket)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </ListContent>
        <ListStatus>
            @if (_status.Current is not null)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success")" role="status">@_status.Current.Message</p>
            }
        </ListStatus>
        <EditorContent>
            <div class="settings-editor-form">
                <div class="settings-field">
                    <label class="settings-label" for="bucket-name">Name</label>
                    <input id="bucket-name" class="settings-input" maxlength="128" @bind="_form.Name" disabled="@IsFormBusy" />
                </div>
            </div>
        </EditorContent>
        <EditorFooter>
            <div class="settings-card-footer settings-actions">
                <button type="button" class="ui-btn ui-btn-primary" disabled="@(!CanSave)" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save bucket")</button>
                <button type="button" class="ui-btn ui-btn-secondary" disabled="@IsFormBusy" @onclick="CancelEditorAsync">Cancel</button>
            </div>
        </EditorFooter>
    </SettingsEditorHost>
}

@code {
    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private bool _deleting;
    private bool _editorOpen;
    private SettingsEditorLayout _editorLayout = SettingsEditorLayout.FullPage;
    private readonly List<BucketDto> _buckets = [];
    private BucketForm _form = new();
    private SettingsSectionStatusHandle _status = null!;

    private bool IsFormBusy => _saving || _deleting;
    private bool CanSave => !IsFormBusy && !string.IsNullOrWhiteSpace(_form.Name);
    private string EditorTitle => _form.Id is null ? "New bucket" : $"Edit {_form.Name}";

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        var result = await Mediator.SendAsync(new ListBucketsRequest(CurrentUser.Id));
        _buckets.Clear();
        if (!result.HasError && result.Payload?.Buckets is { } items)
        {
            _buckets.AddRange(items);
        }

        _busy = TabBusy.None;
    }

    private void BeginAdd()
    {
        _form = new BucketForm();
        _editorOpen = true;
    }

    private void BeginEdit(BucketDto bucket)
    {
        _form = BucketForm.FromDto(bucket);
        _editorOpen = true;
    }

    private Task CancelEditorAsync()
    {
        _editorOpen = false;
        _form = new();
        return Task.CompletedTask;
    }

    private Task OnEditorLayoutChangedAsync(SettingsEditorLayout layout)
    {
        _editorLayout = layout;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = await Mediator.SendAsync(new SaveBucketRequest(CurrentUser.Id, _form.ToDto()));
        if (result.HasError)
        {
            _status.Set(result.Errors.FirstOrDefault()?.Message ?? "Save failed.", isError: true);
        }
        else
        {
            _editorOpen = false;
            await LoadAsync();
        }

        _saving = false;
    }

    private async Task DeleteAsync(BucketDto bucket)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Delete bucket \"{bucket.Name}\"? Members will be unlinked."))
        {
            return;
        }

        _deleting = true;
        var result = await Mediator.SendAsync(new DeleteBucketRequest(CurrentUser.Id, bucket.Id));
        if (!result.HasError)
        {
            await LoadAsync();
        }

        _deleting = false;
    }

    private sealed class BucketForm
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;

        public static BucketForm FromDto(BucketDto dto) => new() { Id = dto.Id, Name = dto.Name };

        public SaveBucketDto ToDto() => new() { Id = Id, Name = Name.Trim() };
    }

    private enum TabBusy { None, Loading }
}
