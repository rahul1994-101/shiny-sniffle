@inherits BaseComponent

@implements IDisposable

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true" aria-label="Loading email accounts">
        <div class="settings-skeleton settings-skeleton-card"></div>
    </div>
}
else
{
    <div class="settings-sections">
        <div class="settings-status-row">
            <p class="ui-status-pill @ListStatusPillClass" role="status">
                <span class="ui-status-pill-label">@ListStatusTitle</span>
                @if (!string.IsNullOrWhiteSpace(ListStatusDetail))
                {
                    <span class="ui-status-pill-detail">@ListStatusDetail</span>
                }
            </p>
        </div>

        <SettingsEditorHost Layout="_editorLayout"
                            LayoutChanged="OnEditorLayoutChangedAsync"
                            LayoutPreferenceKey="email-accounts"
                            EditorOpen="_editorOpen"
                            EditorTitle="@EditorTitle"
                            ListTitle="Connected accounts"
                            CloseAriaLabel="Close account editor"
                            ListHeaderActionsAriaLabel="Connected accounts actions"
                            OnRequestClose="CancelEditorAsync">
            <ListLeadContent>
                Connect one or more inboxes for the Email agent. The <strong>default</strong> account is used when no account is specified.
                IMAP/SMTP templates are under <NavLink href="/settings/email/providers">Providers</NavLink>.
            </ListLeadContent>
            <ListHeaderActions>
                @if (_accounts.Count > 0)
                {
                    <SettingsHeadActionButton Label="Add account"
                                            AriaLabel="Add account"
                                            Disabled="@IsFormBusy"
                                            OnClick="BeginAdd" />
                }
            </ListHeaderActions>
            <ListContent>
                @if (_accounts.Count == 0)
                {
                    <div class="ui-empty-state">
                        <p class="ui-empty-state-title">No accounts yet</p>
                        <p class="ui-empty-state-lead">Add an account with your address and mailbox password.</p>
                        <button type="button"
                                class="ui-btn ui-btn-primary"
                                disabled="@IsFormBusy"
                                @onclick="BeginAdd">
                            Add account
                        </button>
                    </div>
                }
                else
                {
                    <div class="ui-group" aria-label="Email accounts">
                        @foreach (var account in _accounts)
                        {
                            var rowActive = _editorOpen && _form.Id == account.Id;
                            <div class="ui-group-row ui-group-row-static ui-list-row-rich @(rowActive ? "settings-editor-row-active" : null)">
                                <div class="ui-list-row-rich-body">
                                    <span class="ui-list-row-meta">
                                        <span class="ui-group-row-title">@account.Alias</span>
                                        @if (account.IsDefault)
                                        {
                                            <span class="ui-list-row-badge">Default</span>
                                        }
                                    </span>
                                    <span class="ui-group-row-desc">
                                        @FormatAccountReach(account)
                                    </span>
                                    @if (account.Buckets.Count > 0 || account.Tags.Count > 0)
                                    {
                                        <span class="ui-group-row-desc">@FormatAccountTaxonomy(account)</span>
                                    }
                                </div>
                                <div class="ui-list-row-rich-actions">
                                    @if (!account.IsDefault)
                                    {
                                        <button type="button"
                                                class="ui-btn ui-btn-secondary ui-btn-sm"
                                                disabled="@IsFormBusy"
                                                @onclick="() => SetDefaultAsync(account)">
                                            Make default
                                        </button>
                                    }
                                    <button type="button"
                                            class="ui-btn ui-btn-secondary ui-btn-sm"
                                            disabled="@IsFormBusy"
                                            @onclick="() => BeginEditAsync(account)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="ui-btn ui-btn-danger ui-btn-sm"
                                            disabled="@IsFormBusy"
                                            @onclick="() => DeleteAsync(account)">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </ListContent>
            <ListStatus>
                @if (_status.Current is not null)
                {
                    <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                       role="status"
                       aria-live="polite">
                        <span class="ui-status-pill-label">@_status.Current.Message</span>
                    </p>
                }
            </ListStatus>
            <EditorContent>
                @EditorFields
            </EditorContent>
            <EditorFooter>
                <div class="settings-card-footer settings-actions">
                    <button type="button"
                            class="ui-btn ui-btn-primary"
                            disabled="@(!CanSaveEditor)"
                            @onclick="SaveEditorAsync">
                        @(_saving ? "Saving…" : "Save account")
                    </button>
                    <button type="button"
                            class="ui-btn ui-btn-secondary"
                            disabled="@IsFormBusy"
                            @onclick="TestEditorAsync">
                        @(_testing ? "Testing…" : "Test connection")
                    </button>
                    <button type="button"
                            class="ui-btn ui-btn-secondary"
                            disabled="@IsFormBusy"
                            @onclick="CancelEditorAsync">
                        Cancel
                    </button>
                </div>

                @if (_status.Current is not null && _editorOpen)
                {
                    <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                       role="status"
                       aria-live="polite">
                        <span class="ui-status-pill-label">@_status.Current.Message</span>
                    </p>
                }
            </EditorFooter>
        </SettingsEditorHost>
    </div>
}

@code {
    private readonly List<EmailAccountSummaryDto> _accounts = [];
    private readonly List<EmailProviderDto> _catalog = [];
    private readonly List<TagDto> _allTags = [];
    private readonly List<BucketDto> _allBuckets = [];
    private IReadOnlyList<BucketRefDto> _bucketRefs = [];
    private IReadOnlyList<TagRefDto> _tagRefs = [];
    private AccountForm _form = new();
    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private bool _testing;
    private bool _deleting;
    private bool _editorOpen;
    private bool _providerOpen;
    private bool _showPassword;
    private SettingsEditorLayout _editorLayout = SettingsEditorLayout.FullPage;
    private SettingsSectionStatusHandle _status = null!;

    // Deferred — taxonomy linking UI; save/load/sync code stays in place.
    private const bool ShowTaxonomyPicker = false;

    private string EditorTitle =>
        _form.Id is null ? "New account" : "Edit account";

    private static readonly SettingsDropdownField.SettingsDropdownOption[] DefaultOptions =
    [
        new("default", "Yes"),
        new("no", "No")
    ];

    private string DefaultSelect
    {
        get => _form.IsDefault ? "default" : "no";
        set
        {
            var isDefault = string.Equals(value, "default", StringComparison.Ordinal);
            if (_form.IsDefault == isDefault)
            {
                return;
            }

            _form.IsDefault = isDefault;
        }
    }

    private bool IsFormBusy => _saving || _testing || _deleting;

    private bool CanSaveEditor =>
        !IsFormBusy
        && _catalog.Count > 0
        && !string.IsNullOrWhiteSpace(_form.EmailAddress)
        && !string.IsNullOrWhiteSpace(_form.Username)
        && HasRequiredPassword;

    private bool HasRequiredPassword =>
        _form.Id is null
            ? !string.IsNullOrWhiteSpace(_form.Password)
            : _form.HasStoredPassword || !string.IsNullOrWhiteSpace(_form.Password);

    private string ListStatusTitle =>
        _accounts.Count == 0 ? "No accounts connected" : $"{_accounts.Count} account{(_accounts.Count == 1 ? "" : "s")} connected";

    private string ListStatusDetail
    {
        get
        {
            var def = _accounts.FirstOrDefault(a => a.IsDefault);
            if (def is null)
            {
                return _accounts.Count == 0
                    ? "Add an account to connect the Email agent."
                    : "Choose a default account for the Email agent.";
            }

            return $"Default: {def.Alias} · {def.EmailAddress}";
        }
    }

    private string ListStatusPillClass =>
        _accounts.Count == 0 ? "ui-status-pill-warning" : "ui-status-pill-success";

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    private RenderFragment EditorFields => __builder =>
    {
        <div class="settings-editor-form">
            <div class="settings-mail-server settings-account-connection">
                <div class="settings-endpoint-row settings-endpoint-row-duo">
                    <div class="settings-field">
                        <div class="settings-label-row">
                            <label class="settings-label" id="acc-provider-label">Provider</label>
                            @if (_catalog.Count > 0)
                            {
                                <FieldHint AriaLabel="Provider help">
                                    IMAP/SMTP preset — manage under <NavLink href="/settings/email/providers">Providers</NavLink>.
                                </FieldHint>
                            }
                        </div>
                        @if (_catalog.Count == 0)
                        {
                            <p class="settings-hint" role="status">No presets yet — add under <NavLink href="/settings/email/providers">Providers</NavLink>.</p>
                        }
                        else
                        {
                            <div class="settings-provider-picker">
                                @if (_providerOpen)
                                {
                                    <button type="button"
                                            class="settings-provider-backdrop"
                                            tabindex="-1"
                                            aria-hidden="true"
                                            @onclick="CloseProviderPicker"></button>
                                }

                                <button type="button"
                                        id="acc-provider"
                                        class="settings-provider-trigger"
                                        aria-haspopup="listbox"
                                        aria-expanded="@_providerOpen"
                                        aria-labelledby="acc-provider-label acc-provider"
                                        disabled="@IsFormBusy"
                                        @onclick="ToggleProviderPicker">
                                    <span class="settings-provider-trigger-label">@SelectedProviderName()</span>
                                    <svg class="settings-provider-chevron @(_providerOpen ? "settings-provider-chevron-open" : null)"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         aria-hidden="true">
                                        <path d="M6 9l6 6 6-6" />
                                    </svg>
                                </button>

                                @if (_providerOpen)
                                {
                                    <div class="settings-provider-menu ui-dropdown-menu" role="listbox" aria-labelledby="acc-provider-label">
                                        @foreach (var provider in _catalog)
                                        {
                                            var selected = _form.EmailProviderId == provider.Id;
                                            <button type="button"
                                                    role="option"
                                                    aria-selected="@selected"
                                                    class="settings-provider-option ui-dropdown-option @(selected ? "settings-provider-option-active ui-dropdown-option-active" : null)"
                                                    @onclick="() => SelectProvider(provider)">
                                                @provider.Name
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="settings-field">
                        <label class="settings-label" for="acc-email">Email</label>
                        <input id="acc-email"
                               type="email"
                               class="settings-input"
                               @bind="_form.EmailAddress"
                               autocomplete="email"
                               disabled="@IsFormBusy" />
                    </div>
                </div>

                <div class="settings-endpoint-row settings-endpoint-row-duo">
                    <div class="settings-field">
                        <label class="settings-label" for="acc-username">Username</label>
                        <input id="acc-username"
                               type="text"
                               class="settings-input"
                               @bind="_form.Username"
                               autocomplete="username"
                               disabled="@IsFormBusy" />
                    </div>
                    <div class="settings-field">
                        <div class="settings-label-row">
                            <label class="settings-label" for="acc-password">Password</label>
                            <FieldHint AriaLabel="Password help">
                                @PasswordFieldCopy.MailboxHint(_form.Id is null)
                            </FieldHint>
                        </div>
                        <div class="settings-password-wrap">
                            <input id="acc-password"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="settings-input"
                                   @bind="_form.Password"
                                   autocomplete="new-password"
                                   placeholder="@(_form.HasStoredPassword ? "Saved — leave blank to keep" : "App password or mailbox password")"
                                   disabled="@IsFormBusy" />
                            <PasswordVisibilityButton Visible="_showPassword"
                                                      Disabled="@IsFormBusy"
                                                      OnToggle="@(() => _showPassword = !_showPassword)" />
                        </div>
                    </div>
                </div>

                <div class="settings-endpoint-row settings-account-default-row">
                    <SettingsDropdownField Label="Default"
                                           CssClass="settings-field-ssl"
                                           @bind-Value="DefaultSelect"
                                           Options="DefaultOptions"
                                           Disabled="@(IsFormBusy || _form.IsDefaultForced)" />
                </div>
            </div>

            <div class="settings-provider-extras">
                <p class="settings-label">@EntityContextFieldCopy.SectionTitle</p>
                <div class="settings-field">
                    <div class="settings-label-row">
                        <label class="settings-label" for="acc-alias">
                            Alias <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                        </label>
                        <FieldHint AriaLabel="Alias help">
                            @EntityAliasFieldCopy.EmptyFieldHint("email address", "mailboxes")
                        </FieldHint>
                    </div>
                    <input id="acc-alias"
                           type="text"
                           class="settings-input"
                           @bind="_form.Alias"
                           maxlength="64"
                           placeholder="@EntityAliasFieldCopy.PlaceholderAutoFromEmail"
                           disabled="@IsFormBusy" />
                    @if (_form.CanPreviewEntityRef)
                    {
                        <p class="settings-hint">@EntityAliasFieldCopy.EntityRefLead @EntityRefs.Format(EntityRefs.Kind.Mailbox, _form.EffectiveAlias)</p>
                    }
                </div>
                <div class="settings-field">
                    <div class="settings-label-row">
                        <label class="settings-label" for="acc-context">
                            @EntityContextFieldCopy.Label <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                        </label>
                        <FieldHint AriaLabel="Context help">
                            @EntityContextFieldCopy.Hint
                        </FieldHint>
                    </div>
                    <textarea id="acc-context"
                              class="settings-input settings-textarea"
                              rows="3"
                              @bind="_form.Context"
                              maxlength="2000"
                              disabled="@IsFormBusy"></textarea>
                </div>
            </div>

            @if (ShowTaxonomyPicker)
            {
                <ErTaxonomyPicker Buckets="_bucketRefs"
                                  Tags="_tagRefs"
                                  SelectedBucketIds="_form.SelectedBucketIds"
                                  SelectedTagIds="_form.SelectedTagIds"
                                  Disabled="@IsFormBusy" />
            }
        </div>
    };

    private Task OnEditorLayoutChangedAsync(SettingsEditorLayout layout)
    {
        _editorLayout = layout;
        return Task.CompletedTask;
    }

    public void Dispose() => _status.Dispose();

    #region # Load

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        _status.Clear();

        var accountsResult = await Mediator.SendAsync(new GetAllEmailAccountsByUserIdRequest(CurrentUser.Id));
        var catalogResult = await Mediator.SendAsync(new GetAllEmailProvidersByUserIdRequest(CurrentUser.Id));
        var tagsResult = await Mediator.SendAsync(new GetAllTagsByUserIdRequest(CurrentUser.Id));
        var bucketsResult = await Mediator.SendAsync(new GetAllBucketsByUserIdRequest(CurrentUser.Id));

        _allTags.Clear();
        if (!tagsResult.HasError && tagsResult.Payload?.Tags is { } tagItems)
        {
            _allTags.AddRange(tagItems);
        }

        _allBuckets.Clear();
        if (!bucketsResult.HasError && bucketsResult.Payload?.Buckets is { } bucketItems)
        {
            _allBuckets.AddRange(bucketItems);
        }

        _tagRefs = _allTags.ConvertAll(t => t.AsRef());
        _bucketRefs = _allBuckets.ConvertAll(b => b.AsRef());

        if (catalogResult.HasError)
        {
            _status.Set(
                catalogResult.Errors.FirstOrDefault()?.Message ?? "Failed to load provider catalog.",
                isError: true);
            _catalog.Clear();
        }
        else
        {
            _catalog.Clear();
            _catalog.AddRange(catalogResult.Payload.Providers);
        }

        if (accountsResult.HasError)
        {
            _status.Set(
                accountsResult.Errors.FirstOrDefault()?.Message ?? "Failed to load email accounts.",
                isError: true);
            _accounts.Clear();
        }
        else
        {
            _accounts.Clear();
            _accounts.AddRange(accountsResult.Payload.Accounts);
        }

        _busy = TabBusy.None;
    }

    #endregion

    private static string FormatAccountReach(EmailAccountSummaryDto account) =>
        string.Join(" · ", new[] { account.EntityRef, account.EmailAddress, account.ProviderName });

    private static string FormatAccountTaxonomy(EmailAccountSummaryDto account)
    {
        var parts = new List<string>();
        if (account.Buckets.Count > 0)
        {
            parts.Add(string.Join(", ", account.Buckets.Select(b => b.Name)));
        }

        if (account.Tags.Count > 0)
        {
            parts.Add(string.Join(", ", account.Tags.Select(t => t.Name)));
        }

        return string.Join(" · ", parts);
    }

    #region # Editor

    private void BeginAdd()
    {
        _status.Clear();
        _form = new AccountForm
        {
            IsDefault = _accounts.Count == 0,
            IsDefaultForced = _accounts.Count == 0,
            EmailProviderId = ResolveInitialProviderId()
        };
        EnsureProviderInForm();
        _editorOpen = true;
        _showPassword = false;
    }

    private async Task BeginEditAsync(EmailAccountSummaryDto summary)
    {
        _status.Clear();
        _busy = TabBusy.Loading;

        var result = await Mediator.SendAsync(new GetEmailAccountByIdRequest(CurrentUser.Id, summary.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to load account.",
                isError: true);
            _busy = TabBusy.None;
            return;
        }

        _form = AccountForm.FromDto(result.Payload, _accounts.Count <= 1 && result.Payload.IsDefault);
        EnsureProviderInForm();
        _editorOpen = true;
        _showPassword = false;
        _busy = TabBusy.None;
    }

    private Task CancelEditorAsync()
    {
        CloseEditor();
        return Task.CompletedTask;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _form = new AccountForm();
        _providerOpen = false;
        _status.Clear();
    }

    private async Task SaveEditorAsync()
    {
        _saving = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new SaveEmailAccountRequest(CurrentUser.Id, _form.ToSaveDto()));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to save account.",
                isError: true);
        }
        else
        {
            _status.Set("Account saved.", isError: false, autoClear: true);
            CloseEditor();
            await LoadAsync();
        }

        _saving = false;
    }

    private async Task TestEditorAsync()
    {
        _testing = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new TestEmailAccountConnectionRequest(
            CurrentUser.Id,
            _form.ToSaveDto(),
            _form.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Connection test failed.",
                isError: true);
        }
        else
        {
            var testResult = result.Payload.Result;
            _status.Set(testResult.Message, isError: !testResult.Success);
        }

        _testing = false;
    }

    private async Task DeleteAsync(EmailAccountSummaryDto account)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Remove account \"{account.Alias}\" ({account.EmailAddress})? This cannot be undone.");

        if (!confirm)
        {
            return;
        }

        _deleting = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new DeleteEmailAccountRequest(CurrentUser.Id, account.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to delete account.",
                isError: true);
        }
        else
        {
            if (_form.Id == account.Id)
            {
                CloseEditor();
            }

            await LoadAsync();
        }

        _deleting = false;
    }

    private async Task SetDefaultAsync(EmailAccountSummaryDto account)
    {
        _status.Clear();

        var result = await Mediator.SendAsync(new SetDefaultEmailAccountRequest(CurrentUser.Id, account.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to update default account.",
                isError: true);
        }
        else
        {
            _status.Set($"Default account set to \"{account.Alias}\".", isError: false, autoClear: true);
            await LoadAsync();
        }
    }

    #endregion

    #region # Helpers

    private Guid ResolveInitialProviderId()
    {
        if (_catalog.Count == 0)
        {
            return Guid.Empty;
        }

        return _catalog.FirstOrDefault(p => p.IsSystem)?.Id
               ?? _catalog[0].Id;
    }

    private EmailProviderDto? SelectedProvider() =>
        EmailProviderCatalog.FindById(_catalog, _form.EmailProviderId);

    private string SelectedProviderName() =>
        SelectedProvider()?.Name ?? "Select provider";

    private void EnsureProviderInForm()
    {
        if (_catalog.Count == 0)
        {
            return;
        }

        if (EmailProviderCatalog.FindById(_catalog, _form.EmailProviderId) is not null)
        {
            return;
        }

        _form.EmailProviderId = ResolveInitialProviderId();
    }

    private void ToggleProviderPicker()
    {
        if (IsFormBusy || _catalog.Count == 0)
        {
            return;
        }

        _providerOpen = !_providerOpen;
    }

    private void CloseProviderPicker() => _providerOpen = false;

    private void SelectProvider(EmailProviderDto provider)
    {
        _form.EmailProviderId = provider.Id;
        CloseProviderPicker();
    }

    private sealed class AccountForm
    {
        public Guid? Id { get; set; }

        public string Alias { get; set; } = string.Empty;

        public string EffectiveAlias =>
            !string.IsNullOrWhiteSpace(Alias)
                ? EntityAliasPreview.FromNameOrAlias(Alias, string.Empty, "mailbox")
                : EmailAccountAliases.StemFromEmailAddress(EmailAddress);

        public bool CanPreviewEntityRef =>
            !string.IsNullOrWhiteSpace(Alias) || !string.IsNullOrWhiteSpace(EmailAddress);

        public bool IsDefault { get; set; }

        public bool IsDefaultForced { get; set; }

        public Guid EmailProviderId { get; set; }

        public string EmailAddress { get; set; } = string.Empty;

        public string Username { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string? Context { get; set; }

        public bool HasStoredPassword { get; set; }

        public HashSet<Guid> SelectedTagIds { get; } = [];

        public HashSet<Guid> SelectedBucketIds { get; } = [];

        public static AccountForm FromDto(EmailAccountDto dto, bool defaultForced)
        {
            var form = new AccountForm
            {
                Id = dto.Id,
                Alias = dto.Alias,
                IsDefault = dto.IsDefault,
                IsDefaultForced = defaultForced,
                EmailProviderId = dto.EmailProviderId,
                EmailAddress = dto.EmailAddress,
                Username = dto.Username,
                HasStoredPassword = dto.HasStoredPassword,
                Context = dto.Context
            };
            foreach (var t in dto.Tags)
            {
                form.SelectedTagIds.Add(t.Id);
            }

            foreach (var b in dto.Buckets)
            {
                form.SelectedBucketIds.Add(b.Id);
            }

            return form;
        }

        public SaveEmailAccountDto ToSaveDto() => new()
        {
            Id = Id,
            Alias = Alias,
            IsDefault = IsDefault,
            EmailProviderId = EmailProviderId,
            EmailAddress = EmailAddress,
            Username = Username,
            Password = Password,
            Context = Context,
            TagIds = SelectedTagIds.ToList(),
            BucketIds = SelectedBucketIds.ToList()
        };
    }

    private enum TabBusy
    {
        None,
        Loading
    }

    #endregion
}
