@inherits BaseComponent

@if (_busy == TabBusy.Loading)
{
    <div class="settings-loading" role="status" aria-busy="true" aria-label="Loading contacts">
        <div class="settings-skeleton settings-skeleton-card"></div>
    </div>
}
else
{
    <SettingsEditorHost Layout="_editorLayout"
                        LayoutChanged="OnEditorLayoutChangedAsync"
                        LayoutPreferenceKey="workspace-contacts"
                        EditorOpen="_editorOpen"
                        EditorTitle="@EditorTitle"
                        ListTitle="Contacts"
                        ListLead="Use-case references for rules and AI — not a full address book."
                        BackLabel="Back to contacts"
                        CloseAriaLabel="Close contact editor"
                        ListHeaderActionsAriaLabel="Contact list actions"
                        OnRequestClose="CancelEditorAsync">
        <ListHeaderActions>
            @if (_contacts.Count > 0)
            {
                <SettingsHeadActionButton Label="Add contact"
                                        AriaLabel="Add contact"
                                        Disabled="@IsFormBusy"
                                        OnClick="BeginAdd" />
            }
        </ListHeaderActions>
        <ListContent>
            @if (_contacts.Count == 0)
            {
                <div class="ui-empty-state">
                    <p class="ui-empty-state-title">No contacts yet</p>
                    <p class="ui-empty-state-lead">Add someone your workflows or agents should recognize by name.</p>
                    <button type="button"
                            class="ui-btn ui-btn-primary"
                            disabled="@IsFormBusy"
                            @onclick="BeginAdd">
                        Add contact
                    </button>
                </div>
            }
            else
            {
                <div class="ui-group" aria-label="Contacts">
                    @foreach (var contact in _contacts)
                    {
                        var rowActive = _editorOpen && _form.Id == contact.Id;
                        <div class="ui-group-row ui-group-row-static ui-list-row-rich @(rowActive ? "settings-editor-row-active" : null)">
                            <div class="ui-list-row-rich-body">
                                <span class="ui-list-row-meta">
                                    <span class="ui-group-row-title">@contact.ListLabel</span>
                                </span>
                                <span class="ui-group-row-desc">@FormatReach(contact)</span>
                                @if (contact.Buckets.Count > 0 || contact.Tags.Count > 0)
                                {
                                    <span class="ui-group-row-desc">@FormatTaxonomy(contact)</span>
                                }
                            </div>
                            <div class="ui-list-row-rich-actions">
                                <button type="button"
                                        class="ui-btn ui-btn-secondary ui-btn-sm"
                                        disabled="@IsFormBusy"
                                        @onclick="() => BeginEditAsync(contact)">
                                    Edit
                                </button>
                                <button type="button"
                                        class="ui-btn ui-btn-danger ui-btn-sm"
                                        disabled="@IsFormBusy"
                                        @onclick="() => DeleteAsync(contact)">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </ListContent>
        <ListStatus>
            @if (_status.Current is not null)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                   role="status"
                   aria-live="polite">
                    <span class="ui-status-pill-label">@_status.Current.Message</span>
                </p>
            }
        </ListStatus>
        <EditorContent>
            @EditorFields
        </EditorContent>
        <EditorFooter>
            <div class="settings-card-footer settings-actions">
                <button type="button"
                        class="ui-btn ui-btn-primary"
                        disabled="@(!CanSaveEditor)"
                        @onclick="SaveEditorAsync">
                    @(_saving ? "Saving…" : "Save contact")
                </button>
                <button type="button"
                        class="ui-btn ui-btn-secondary"
                        disabled="@IsFormBusy"
                        @onclick="CancelEditorAsync">
                    Cancel
                </button>
            </div>

            @if (_status.Current is not null && _editorOpen)
            {
                <p class="ui-status-pill @(_status.Current.IsError ? "ui-status-pill-error" : "ui-status-pill-success") @(_status.Current.Fading ? "ui-status-pill-fading" : null)"
                   role="status"
                   aria-live="polite">
                    <span class="ui-status-pill-label">@_status.Current.Message</span>
                </p>
            }
        </EditorFooter>
    </SettingsEditorHost>
}

@code {
    [CascadingParameter]
    public SettingsPageContext PageContext { get; set; } = null!;

    private TabBusy _busy = TabBusy.Loading;
    private bool _saving;
    private bool _deleting;
    private bool _editorOpen;
    private SettingsEditorLayout _editorLayout = SettingsEditorLayout.FullPage;
    private readonly List<ContactSummaryDto> _contacts = [];
    private readonly List<TagDto> _allTags = [];
    private readonly List<BucketDto> _allBuckets = [];
    private IReadOnlyList<BucketRefDto> _bucketRefs = [];
    private IReadOnlyList<TagRefDto> _tagRefs = [];
    private ContactForm _form = new();
    private ContactForm _formBaseline = new();
    private SettingsSectionStatusHandle _status = null!;

    private bool IsFormBusy => _saving || _deleting;

    private bool IsFormDirty =>
        !_form.ContentEquals(_formBaseline);

    private bool CanSaveEditor =>
        !IsFormBusy
        && !string.IsNullOrWhiteSpace(_form.FirstName)
        && IsFormDirty;

    private string EditorTitle =>
        _form.Id is null ? "New contact" : $"Edit {_form.ListLabel}";

    protected override async Task OnInitializedAsync()
    {
        _status = new SettingsSectionStatusHandle(() => InvokeAsync(StateHasChanged));
        await LoadAsync();
    }

    private RenderFragment EditorFields => __builder =>
    {
        <div class="settings-editor-form">
            <div class="settings-endpoint-row settings-endpoint-row-duo">
                <div class="settings-field">
                    <label class="settings-label" for="contact-first-name">First name</label>
                    <input id="contact-first-name"
                           type="text"
                           class="settings-input"
                           @bind="_form.FirstName"
                           @bind:after="OnFormEdited"
                           maxlength="50"
                           autocomplete="given-name"
                           disabled="@IsFormBusy" />
                </div>
                <div class="settings-field">
                    <label class="settings-label" for="contact-last-name">
                        Last name <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                    </label>
                    <input id="contact-last-name"
                           type="text"
                           class="settings-input"
                           @bind="_form.LastName"
                           @bind:after="OnFormEdited"
                           maxlength="50"
                           autocomplete="family-name"
                           disabled="@IsFormBusy" />
                </div>
            </div>
            <div class="settings-endpoint-row settings-endpoint-row-duo">
                <div class="settings-field">
                    <label class="settings-label" for="contact-email">
                        Email <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                    </label>
                    <input id="contact-email"
                           type="email"
                           class="settings-input"
                           @bind="_form.Email"
                           @bind:after="OnFormEdited"
                           autocomplete="off"
                           disabled="@IsFormBusy" />
                </div>
                <div class="settings-field">
                    <label class="settings-label" for="contact-phone">
                        Phone <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                    </label>
                    <input id="contact-phone"
                           type="tel"
                           class="settings-input"
                           @bind="_form.Phone"
                           @bind:after="OnFormEdited"
                           autocomplete="off"
                           disabled="@IsFormBusy" />
                </div>
            </div>
            <div class="settings-provider-extras">
                <p class="settings-label">@EntityContextFieldCopy.SectionTitle</p>
                <div class="settings-field">
                    <label class="settings-label" for="contact-alias">
                        Alias <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                    </label>
                    <input id="contact-alias"
                           type="text"
                           class="settings-input"
                           @bind="_form.Alias"
                           @bind:after="OnFormEdited"
                           maxlength="64"
                           placeholder="@EntityAliasFieldCopy.PlaceholderAutoFromName"
                           disabled="@IsFormBusy" />
                    @if (_form.CanPreviewEntityRef)
                    {
                        <p class="settings-hint">@EntityAliasFieldCopy.EntityRefLead @EntityRefs.Format(EntityRefs.Kind.Contact, _form.EffectiveAlias)</p>
                    }
                    else
                    {
                        <p class="settings-hint">@EntityAliasFieldCopy.EmptyFieldHint("first and last name", "contacts")</p>
                    }
                </div>
                <div class="settings-field">
                    <label class="settings-label" for="contact-context">
                        @EntityContextFieldCopy.Label <span class="settings-label-optional">@FormFieldCopy.OptionalMarker</span>
                    </label>
                    <textarea id="contact-context"
                              class="settings-input settings-textarea"
                              rows="3"
                              @bind="_form.Context"
                              @bind:after="OnFormEdited"
                              maxlength="2000"
                              disabled="@IsFormBusy"></textarea>
                    <p class="settings-hint">@EntityContextFieldCopy.Hint</p>
                </div>
            </div>
            <ErTaxonomyPicker Buckets="_bucketRefs"
                              Tags="_tagRefs"
                              SelectedBucketIds="_form.SelectedBucketIds"
                              SelectedTagIds="_form.SelectedTagIds"
                              Disabled="@IsFormBusy"
                              SelectionChanged="OnFormEdited" />
        </div>
    };

    private void OnFormEdited() => SyncDirtyState();

    private void SyncDirtyState() =>
        PageContext.SetEditorDirty(_editorOpen && IsFormDirty);

    private static string FormatReach(ContactSummaryDto contact)
    {
        var parts = new List<string>(3);
        if (!string.IsNullOrWhiteSpace(contact.EntityRef))
        {
            parts.Add(contact.EntityRef);
        }

        if (!string.IsNullOrWhiteSpace(contact.Email))
        {
            parts.Add(contact.Email);
        }

        if (!string.IsNullOrWhiteSpace(contact.Phone))
        {
            parts.Add(contact.Phone);
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : "No alias, email, or phone";
    }

    private static string FormatTaxonomy(ContactSummaryDto contact)
    {
        var parts = new List<string>();
        if (contact.Buckets.Count > 0)
        {
            parts.Add(string.Join(", ", contact.Buckets.Select(b => b.Name)));
        }

        if (contact.Tags.Count > 0)
        {
            parts.Add(string.Join(", ", contact.Tags.Select(t => t.Name)));
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : string.Empty;
    }

    private Task OnEditorLayoutChangedAsync(SettingsEditorLayout layout)
    {
        _editorLayout = layout;
        return Task.CompletedTask;
    }

    #region # Load

    private async Task LoadAsync()
    {
        _busy = TabBusy.Loading;
        _status.Clear();

        var result = await Mediator.SendAsync(new ListContactsRequest(CurrentUser.Id));
        var tagsResult = await Mediator.SendAsync(new ListTagsRequest(CurrentUser.Id));
        var bucketsResult = await Mediator.SendAsync(new ListBucketsRequest(CurrentUser.Id));

        _allTags.Clear();
        if (!tagsResult.HasError && tagsResult.Payload?.Tags is { } tagItems)
        {
            _allTags.AddRange(tagItems);
        }

        _allBuckets.Clear();
        if (!bucketsResult.HasError && bucketsResult.Payload?.Buckets is { } bucketItems)
        {
            _allBuckets.AddRange(bucketItems);
        }

        _tagRefs = _allTags.ConvertAll(t => t.AsRef());
        _bucketRefs = _allBuckets.ConvertAll(b => b.AsRef());

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to load contacts.",
                isError: true);
            _contacts.Clear();
        }
        else if (result.Payload?.Contacts is { } items)
        {
            _contacts.Clear();
            _contacts.AddRange(items);
        }

        _busy = TabBusy.None;
    }

    #endregion

    #region # Editor

    private void BeginAdd()
    {
        _status.Clear();
        _form = new ContactForm();
        _formBaseline = _form.Clone();
        _editorOpen = true;
        SyncDirtyState();
    }

    private async Task BeginEditAsync(ContactSummaryDto summary)
    {
        _status.Clear();
        var result = await Mediator.SendAsync(new GetContactRequest(CurrentUser.Id, summary.Id));

        if (result.HasError || result.Payload is null)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to load contact.",
                isError: true);
            return;
        }

        _form = ContactForm.FromDto(result.Payload);
        _formBaseline = _form.Clone();
        _editorOpen = true;
        SyncDirtyState();
    }

    private async Task CancelEditorAsync()
    {
        if (_editorOpen && IsFormDirty
            && !await JsRuntime.InvokeAsync<bool>("confirm", SettingsDirtyGuard.DiscardMessage))
        {
            return;
        }

        CloseEditor();
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _form = new ContactForm();
        _formBaseline = new ContactForm();
        _status.Clear();
        SyncDirtyState();
    }

    private async Task SaveEditorAsync()
    {
        _saving = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new SaveContactRequest(CurrentUser.Id, _form.ToSaveDto()));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to save contact.",
                isError: true);
        }
        else
        {
            _status.Set("Contact saved.", isError: false, autoClear: true);
            CloseEditor();
            await LoadAsync();
        }

        _saving = false;
    }

    private async Task DeleteAsync(ContactSummaryDto contact)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Delete contact \"{contact.ListLabel}\"? This cannot be undone.");

        if (!confirm)
        {
            return;
        }

        _deleting = true;
        _status.Clear();

        var result = await Mediator.SendAsync(new DeleteContactRequest(CurrentUser.Id, contact.Id));

        if (result.HasError)
        {
            _status.Set(
                result.Errors.FirstOrDefault()?.Message ?? "Failed to delete contact.",
                isError: true);
        }
        else
        {
            if (_form.Id == contact.Id)
            {
                CloseEditor();
            }

            await LoadAsync();
        }

        _deleting = false;
    }

    #endregion

    #region # Helpers

    private sealed class ContactForm
    {
        public Guid? Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string? Alias { get; set; }

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public string? Context { get; set; }

        public HashSet<Guid> SelectedTagIds { get; } = [];

        public HashSet<Guid> SelectedBucketIds { get; } = [];

        /// <summary>Alias entered in the form, or slug preview when blank.</summary>
        public string EffectiveAlias =>
            !string.IsNullOrWhiteSpace(Alias)
                ? EntityAliasPreview.FromNameOrAlias(Alias, string.Empty, "contact")
                : string.IsNullOrWhiteSpace(FirstName)
                    ? string.Empty
                    : ContactAliases.StemFromName(FirstName, LastName);

        public bool CanPreviewEntityRef =>
            !string.IsNullOrWhiteSpace(Alias) || !string.IsNullOrWhiteSpace(FirstName);

        public string ListLabel =>
            string.IsNullOrWhiteSpace(LastName)
                ? FirstName.Trim()
                : $"{FirstName.Trim()} {LastName.Trim()}";

        public static ContactForm FromDto(ContactDto dto)
        {
            var form = new ContactForm
            {
                Id = dto.Id,
                FirstName = dto.FirstName,
                LastName = dto.LastName,
                Alias = dto.Alias,
                Email = dto.Email,
                Phone = dto.Phone,
                Context = dto.Context
            };
            foreach (var t in dto.Tags)
            {
                form.SelectedTagIds.Add(t.Id);
            }

            foreach (var b in dto.Buckets)
            {
                form.SelectedBucketIds.Add(b.Id);
            }

            return form;
        }

        public ContactForm Clone()
        {
            var c = new ContactForm
            {
                Id = Id,
                FirstName = FirstName,
                LastName = LastName,
                Alias = Alias,
                Email = Email,
                Phone = Phone,
                Context = Context
            };
            foreach (var id in SelectedTagIds)
            {
                c.SelectedTagIds.Add(id);
            }

            foreach (var id in SelectedBucketIds)
            {
                c.SelectedBucketIds.Add(id);
            }

            return c;
        }

        public bool ContentEquals(ContactForm other) =>
            Id == other.Id
            && string.Equals(FirstName, other.FirstName, StringComparison.Ordinal)
            && string.Equals(LastName, other.LastName, StringComparison.Ordinal)
            && string.Equals(Alias ?? "", other.Alias ?? "", StringComparison.Ordinal)
            && string.Equals(Email ?? "", other.Email ?? "", StringComparison.OrdinalIgnoreCase)
            && string.Equals(Phone ?? "", other.Phone ?? "", StringComparison.Ordinal)
            && string.Equals(Context ?? "", other.Context ?? "", StringComparison.Ordinal)
            && SelectedTagIds.SetEquals(other.SelectedTagIds)
            && SelectedBucketIds.SetEquals(other.SelectedBucketIds);

        public SaveContactDto ToSaveDto() => new()
        {
            Id = Id,
            FirstName = FirstName,
            LastName = LastName,
            Alias = Alias,
            Email = Email,
            Phone = Phone,
            Context = Context,
            TagIds = SelectedTagIds.ToList(),
            BucketIds = SelectedBucketIds.ToList()
        };
    }

    private enum TabBusy
    {
        None,
        Loading
    }

    #endregion
}
