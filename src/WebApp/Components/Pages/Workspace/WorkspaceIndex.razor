@page "/workspace"
@inherits BaseComponent

@attribute [Authorize]

<PageTitle>Workspace</PageTitle>

<SettingsShell Title="Workspace"
               Subtitle="User-owned data for agents and the product.">
    <div class="settings-sections">
        <nav class="ui-group" aria-label="Data">
            @foreach (var area in _dataAreas)
            {
                <NavLink class="ui-group-row" href="@area.Href">
                    <span class="ui-group-row-leading">
                        <NavIcon Name="@area.Icon" CssClass="ui-group-row-icon" />
                        <span>
                            <span class="ui-group-row-title">@area.Title</span>
                            <span class="ui-group-row-desc">@area.Lead</span>
                        </span>
                    </span>
                    <span class="ui-group-row-chevron" aria-hidden="true">›</span>
                </NavLink>
            }
        </nav>

        <nav class="ui-group" aria-label="Organization">
            @foreach (var area in _organizationAreas)
            {
                <NavLink class="ui-group-row" href="@area.Href">
                    <span class="ui-group-row-leading">
                        <NavIcon Name="@area.Icon" CssClass="ui-group-row-icon" />
                        <span>
                            <span class="ui-group-row-title">@area.Title</span>
                            <span class="ui-group-row-desc">@area.Lead</span>
                        </span>
                    </span>
                    <span class="ui-group-row-chevron" aria-hidden="true">›</span>
                </NavLink>
            }
        </nav>
    </div>
</SettingsShell>

@code {
    private static readonly WorkspaceArea[] _dataAreas =
    [
        new("/workspace/contacts", "Contacts", "People you reference in rules and workflows.", NavIconName.Contacts),
        new("/workspace/email/accounts", "Email accounts", "Connected inboxes for the Email agent.", NavIconName.EmailAccounts)
    ];

    private static readonly WorkspaceArea[] _organizationAreas =
    [
        new("/workspace/buckets", "Buckets", "Named groups for contacts and mailboxes.", NavIconName.Buckets),
        new("/workspace/tags", "Tags", "Labels for contacts and mailboxes.", NavIconName.Tags)
    ];

    private sealed record WorkspaceArea(string Href, string Title, string Lead, NavIconName Icon);
}
